<UserControl
    x:Class="RealEstateInstallmentsManager.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
    FlowDirection="RightToLeft">

    <!-- Split screen: a fixed-width white form + a flexible dark brand panel.
         FlowDirection="RightToLeft" on the root (matching most other list screens
         in the app, e.g. CustomerViewInstallment) mirrors Grid column order, so
         column 0 lands on the physical right and column 1 on the physical left -
         same as the mockup's own CSS grid under dir="rtl". That's why the form
         (480px) is column 0 and the dark panel ("*") is column 1, even though the
         dark Border is written first below.
         Correction: FlowDirection does NOT auto-right-align TextBlock/CheckBox
         content by itself (an earlier version of this comment claimed it did -
         wrong, caught by the developer). Every stretched TextBlock below needs
         its own explicit TextAlignment="Right" (or HorizontalAlignment="Right"
         for non-text controls), same lesson already applied to Theme.axaml's
         shared classes for the receipt screen. -->
    <Grid ColumnDefinitions="480,*">

        <!-- Dark brand panel - logo mark, a centered heading, and a small line
             at the bottom. Kept deliberately minimal per the developer's request. -->
        <Border Grid.Column="1" Background="{DynamicResource BrushInk}" Padding="70,60">
            <!-- ColumnDefinitions="Auto,*": HorizontalAlignment="Right" alone was
                 not reliably placing the logo (still came out on the left). An
                 Auto column that's FIRST in source order maps to the physical
                 right under the root's RightToLeft (confirmed pattern, same as
                 the two-column layout at the very top of this file) - it has no
                 spare space to place content "wrong" in, unlike a stretched "*"
                 column plus an alignment value. The heading/bottom text still
                 span both columns so their own width/wrapping is unaffected. -->
            <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">

                <!-- The client's full logo (wordmark + mark), dark-background
                     variant (gold + white instead of gold + ink), rendered via
                     Avalonia.Svg.Skia. Original file is 178.5x44 - kept the
                     same ratio here (162x40).
                     FlowDirection="LeftToRight": the root's RightToLeft mirrors
                     actual pixel content for graphical elements (Path/Image/Svg/
                     Rectangle/Canvas...), not just their position - unlike text,
                     which Avalonia deliberately never mirrors. Without this, the
                     logo rendered as a horizontally-flipped mirror image (caught
                     by the developer: "الشعار معكوس"). -->
                <svg:Svg Grid.Row="0" Grid.Column="0" Width="162" Height="40"
                         FlowDirection="LeftToRight"
                         Path="avares://RealEstateInstallmentsManager/Assets/Logo/logo-full-dark.svg"/>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
                           TextAlignment="Right" MaxWidth="480"
                           Text="إدارة العقارات والأقساط لمؤسسة فلاح العوفي"
                           FontSize="30" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                           Text="عقارات · أقساط" FontSize="12" Foreground="#8FA09D"/>
            </Grid>
        </Border>

        <!-- Login form -->
        <Grid Grid.Column="0" Background="{DynamicResource BrushSurface}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="60,0" VerticalAlignment="Center" Spacing="16" MaxWidth="360">

                    <StackPanel Spacing="4">
                        <TextBlock Text="تسجيل الدخول" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushInk}" TextAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="البريد الإلكتروني" FontSize="13"
                                   Foreground="{DynamicResource BrushMuted}" TextAlignment="Right"/>
                        <TextBox x:Name="EmailBox"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="كلمة المرور" FontSize="13"
                                   Foreground="{DynamicResource BrushMuted}" TextAlignment="Right"/>
                        <Grid>
                            <TextBox x:Name="PasswordBox" PasswordChar="*" Padding="9,9,12,9"/>
                            <Button x:Name="TogglePasswordButton" Classes="outline"
                                    ToolTip.Tip="إظهار كلمة المرور"
                                    Padding="7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"
                                    Click="TogglePassword_Click">
                                <!-- FlowDirection="LeftToRight": same mirroring
                                     issue as the logo above - graphical content
                                     gets flipped by the ambient RightToLeft
                                     otherwise, even though an eye shape is close
                                     to symmetric enough that it wasn't reported. -->
                                <Viewbox Width="16" Height="16" FlowDirection="LeftToRight">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{DynamicResource Icon.Eye}"
                                              Stroke="{DynamicResource BrushInk}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Visual only: no session persistence exists in AuthService yet.
                         Tracked as a future task, not wired to anything real. -->
                    <CheckBox Content="تذكرني على هذا الجهاز" IsChecked="True"/>

                    <Button Content="دخول" Classes="primary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="0,12" FontSize="15"
                            Click="Login_Click"/>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BrushLate}"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="13"/>

                    <!-- Real connectivity status - see ConnectivityService. -->
                    <Border Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushLine}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border x:Name="ConnDot" Width="9" Height="9" CornerRadius="5"
                                    Background="{DynamicResource BrushMuted}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ConnStatusText" Text="جارٍ التحقق من الاتصال..."
                                           FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushInk}"
                                           TextAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <TextBlock Text="{ReflectionBinding AppVersion}" FontSize="11"
                       Foreground="{DynamicResource BrushMuted}"
                       Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</UserControl>
