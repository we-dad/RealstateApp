<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Shared visual identity for مؤسسة فلاح حماد العوفي التجارية (rebranded from
      "المسار الذهبي" - same client, new official identity: navy+gold instead of
      dark-ink+gold). Colors, chips and the nav bar live here; screen layout,
      navigation flow and all logic are untouched - this file only changes how
      things look. Values ported directly from the client's reference mockups
      and AlOufi-Logo-Kit/colors.css.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <SolidColorBrush x:Key="BrushBg" Color="#F6F7FA"/>
            <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BrushInk" Color="#06214A"/>
            <SolidColorBrush x:Key="BrushInkHover" Color="#0E3264"/>
            <SolidColorBrush x:Key="BrushMuted" Color="#5B6B80"/>
            <SolidColorBrush x:Key="BrushLine" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="BrushGold" Color="#C39A45"/>
            <SolidColorBrush x:Key="BrushGoldHover" Color="#B38A38"/>
            <SolidColorBrush x:Key="BrushGoldSoft" Color="#F7EEDB"/>
            <SolidColorBrush x:Key="BrushOk" Color="#2F7A4F"/>
            <SolidColorBrush x:Key="BrushOkSoft" Color="#DCEFE3"/>
            <SolidColorBrush x:Key="BrushLate" Color="#B3261E"/>
            <SolidColorBrush x:Key="BrushLateSoft" Color="#F6DEDB"/>
            <!-- Muted text / line colors specifically for use ON the dark navy
                 background (nav bar, login's dark panel) - too light to use on
                 the white surface. -->
            <SolidColorBrush x:Key="BrushMutedOnDark" Color="#B8C4D9"/>
            <SolidColorBrush x:Key="BrushLineOnDark" Color="#1D3A66"/>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===================== Module top bar (dark, gold active tab) ===================== -->

    <Style Selector="Border.navBar">
        <Setter Property="Background" Value="{DynamicResource BrushInk}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style Selector="Button.navBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMutedOnDark}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushInkHover}"/>
    </Style>
    <Style Selector="Button.navBtn.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushGold}"/>
    </Style>
    <Style Selector="Button.navBtn.active">
        <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.navHome">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMutedOnDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLineOnDark}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!-- Main CTA (login, save...). In the client's updated reference mockups,
         ".btn-gold" (the class used for these exact buttons: "دخول", "حفظ السند")
         is overridden near the end of every page's stylesheet to use the navy
         ink color instead of gold, with a separate new ".btn-add" class holding
         the actual gold for "add a new record" actions specifically - confirmed
         consistent across index.html/modules.html/receipt.html/contracts.html,
         not a one-off. Gold is no longer the general primary-action color. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrushInk}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushInkHover}"/>
    </Style>

    <!-- The actual gold action button now, matching the reference design's new
         ".btn-add" - reserved for "add a new record" style actions. Not used by
         any screen yet (nothing built so far has one), added now so it's ready. -->
    <Style Selector="Button.add">
        <Setter Property="Background" Value="{DynamicResource BrushGold}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.add:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushGoldHover}"/>
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource BrushInk}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="14,9"/>
    </Style>

    <Style Selector="Button.outline">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="14,9"/>
    </Style>

    <!-- ===================== Cards ===================== -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- A clickable card that's a Button underneath (e.g. the module-picker
         cards). Both cards look identical at rest (plain line-grey border) -
         no permanent "featured" highlight - and the border animates smoothly
         to gold only while hovered, as a "you're about to pick this" cue,
         instead of FluentTheme's default abrupt hover fill/border change. -->
    <Style Selector="Button.moduleCard /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.moduleCard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushGold}"/>
    </Style>

    <!-- The card's icon: grey at rest, same gold hover transition as the border.
         No Stroke set locally on the Path elements in MainMenuView.axaml - a
         local value would win over this style and make the hover change
         ineffective. -->
    <Style Selector="Button.moduleCard Path">
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.moduleCard:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource BrushGold}"/>
    </Style>

    <!-- ===================== Status chip ===================== -->
    <!-- A small pill: Border.chip carrying Classes "ok" (green) or "late" (red/muted). -->

    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip TextBlock, Border.chip SelectableTextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip.ok">
        <Setter Property="Background" Value="{DynamicResource BrushOkSoft}"/>
    </Style>
    <Style Selector="Border.chip.ok TextBlock, Border.chip.ok SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushOk}"/>
    </Style>
    <Style Selector="Border.chip.late">
        <Setter Property="Background" Value="{DynamicResource BrushLateSoft}"/>
    </Style>
    <Style Selector="Border.chip.late TextBlock, Border.chip.late SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushLate}"/>
    </Style>
    <Style Selector="Border.chip.neutral">
        <Setter Property="Background" Value="{DynamicResource BrushGoldSoft}"/>
    </Style>
    <Style Selector="Border.chip.neutral TextBlock, Border.chip.neutral SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushGold}"/>
    </Style>

    <!-- ===================== Stat tiles (hairline grid) ===================== -->
    <!-- Put on a Grid with ColumnSpacing/RowSpacing="1" and Background="{DynamicResource BrushLine}":
         each cell (a Border.statCell) is a solid tile, so the 1px gaps read as hairline dividers. -->

    <Style Selector="Grid.statGrid">
        <Setter Property="Background" Value="{DynamicResource BrushLine}"/>
        <Setter Property="ColumnSpacing" Value="1"/>
        <Setter Property="RowSpacing" Value="1"/>
    </Style>
    <Style Selector="Border.statCell">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="TextBlock.statLabel, SelectableTextBlock.statLabel">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style Selector="TextBlock.statValue, SelectableTextBlock.statValue">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ===================== Live-preview box (soft gold) ===================== -->
    <!-- e.g. the receipt screen: what a typed amount covers, before the user saves it. -->

    <Style Selector="Border.preview">
        <Setter Property="Background" Value="{DynamicResource BrushGoldSoft}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style Selector="Border.preview TextBlock.previewLabel, Border.preview SelectableTextBlock.previewLabel">
        <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style Selector="Border.preview TextBlock.previewValue, Border.preview SelectableTextBlock.previewValue">
        <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ===================== Info box (product / customer / owner...) ===================== -->

    <Style Selector="Border.infoBox">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="TextBlock.infoBoxTitle, SelectableTextBlock.infoBoxTitle">
        <Setter Property="Foreground" Value="{DynamicResource BrushGold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style Selector="TextBlock.infoBoxRowLabel, SelectableTextBlock.infoBoxRowLabel">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ===================== Installment progress strip ===================== -->
    <!-- One cell per month: a fixed-size Grid built in code (ReceiptViewInstallment),
         since its fill height is computed per contract, not something a static style
         can express. This just gives the base tile look. -->

    <Style Selector="Border.stripCell">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Border.stripCell.late">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLate}"/>
        <Setter Property="Background" Value="{DynamicResource BrushLateSoft}"/>
    </Style>
</Styles>
