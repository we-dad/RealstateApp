<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealEstateInstallmentsManager.App"
             RequestedThemeVariant="Light">
             <!-- Pinned to Light: the palette in Main/Theme.axaml (light backgrounds, dark
                  ink text) is designed for Light mode only. "Default" follows the OS theme,
                  which mixed our light colors with FluentTheme's dark-mode controls (buttons,
                  text boxes, DataGrid...) on a Mac set to Dark Mode. A real Dark variant is a
                  separate task (a second palette + a way to switch), not done yet. -->

   <Application.Resources>
    <ResourceDictionary>
     <ResourceDictionary.MergedDictionaries>
      <!-- Client-provided icon set: StreamGeometry paths ready for Avalonia
           (24x24, stroke 1.8), no SVG-rendering library needed. Referenced
           as DynamicResource from other files (see Main/Theme.axaml's own
           comment on why StaticResource across separately-loaded files can
           silently fail to resolve in Avalonia). -->
      <ResourceInclude Source="avares://RealEstateInstallmentsManager/Main/Icons.axaml"/>
     </ResourceDictionary.MergedDictionaries>

    <!-- Cairo - replaces IBM Plex Sans Arabic per the client's rebranded identity
         (AlOufi-Logo-Kit recommends Cairo). Same folder+embedding pattern already
         proven to work for IBM Plex Sans Arabic (4 static weight files: Regular/
         Medium/SemiBold/Bold, not the variable-font file - untested combination,
         avoided on purpose), so the resource-embedding class of bug that took 5
         attempts to find is already fixed at the project level
         (AvaloniaResource Include="Assets\Fonts\**" already covers this folder).
         The one residual, unconfirmed risk from that whole saga: attempt 1's
         native crash (SIGABRT) was suspected - never fully confirmed - to be
         about the 4 files' internal font-name-table entries not matching
         cleanly when grouped as one family. Cairo is a much more actively
         maintained, standard Google Font than that IBM Plex Sans Arabic
         download was, so this is considered low-risk, but still genuinely
         untested until the developer opens the app. -->
    <FontFamily x:Key="ArabicFontFamily">avares://RealEstateInstallmentsManager/Assets/Fonts#Cairo</FontFamily>
    </ResourceDictionary>
   </Application.Resources>

   <Application.Styles>
    <FluentTheme />

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Visual identity: palette, chips, nav bar and card styles. -->
    <StyleInclude Source="avares://RealEstateInstallmentsManager/Main/Theme.axaml"/>

    <!-- Cairo (see the comment on ArabicFontFamily above). UNTESTED - if it
         crashes, the safe fallback proven earlier this project is a single-
         weight subfolder (e.g. Assets/Fonts/Regular containing only
         Cairo-Regular.ttf) before falling all the way back to "Arial". -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <!-- App-wide background (every native Window: the main window and every popup
         add/edit window), replacing the default white/system color. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
    </Style>
</Application.Styles>
</Application>
