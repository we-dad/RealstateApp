<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealEstateInstallmentsManager.App"
             RequestedThemeVariant="Light">
             <!-- Pinned to Light: the palette in Main/Theme.axaml (light backgrounds, dark
                  ink text) is designed for Light mode only. "Default" follows the OS theme,
                  which mixed our light colors with FluentTheme's dark-mode controls (buttons,
                  text boxes, DataGrid...) on a Mac set to Dark Mode. A real Dark variant is a
                  separate task (a second palette + a way to switch), not done yet. -->

   <Application.Resources>
    <ResourceDictionary>
     <ResourceDictionary.MergedDictionaries>
      <!-- Client-provided icon set: StreamGeometry paths ready for Avalonia
           (24x24, stroke 1.8), no SVG-rendering library needed. Referenced
           as DynamicResource from other files (see Main/Theme.axaml's own
           comment on why StaticResource across separately-loaded files can
           silently fail to resolve in Avalonia). -->
      <ResourceInclude Source="avares://RealEstateInstallmentsManager/Main/Icons.axaml"/>
     </ResourceDictionary.MergedDictionaries>

    <!-- IBM Plex Sans Arabic - working.
         The real bug (attempts 1-3 all hit it, with different symptoms): the .csproj
         never had an AvaloniaResource entry for Assets/Fonts, so every avares:// URI
         pointed at a folder Avalonia had never embedded. Fixed by adding
         <AvaloniaResource Include="Assets\Fonts\**" /> to the .csproj. Confirmed
         working with the single Regular file (developer tested, app opens fine).
         Now pointing back at the full Assets/Fonts folder (all 4 weight files) -
         this is the exact same folder+URI attempt 1 used, now that the files are
         actually embedded, so it should give real Medium/SemiBold/Bold instead of
         Avalonia's synthetic (faux) bold. Not yet tested at 4 weights. -->
    <FontFamily x:Key="ArabicFontFamily">avares://RealEstateInstallmentsManager/Assets/Fonts#IBM Plex Sans Arabic</FontFamily>
    </ResourceDictionary>
   </Application.Resources>

   <Application.Styles>
    <FluentTheme />

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Visual identity: palette, chips, nav bar and card styles. -->
    <StyleInclude Source="avares://RealEstateInstallmentsManager/Main/Theme.axaml"/>

    <!-- IBM Plex Sans Arabic (see the comment on ArabicFontFamily above). Now
         trying the full 4-weight family - UNTESTED at this step. If it crashes
         again, the safe fallback is to point ArabicFontFamily back at
         Assets/Fonts/Regular alone (confirmed working), not all the way back
         to "Arial". -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <!-- App-wide background (every native Window: the main window and every popup
         add/edit window), replacing the default white/system color. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
    </Style>
</Application.Styles>
</Application>
