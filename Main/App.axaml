<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealEstateInstallmentsManager.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

   <Application.Resources>
    <!-- IBM Plex Sans Arabic crashes Avalonia's text shaper on startup (SIGABRT in
         Avalonia.Media.TextFormatting.TextFormatterImpl.ShapeTextRuns, on the very
         first TextBlock measured - before the font is even used on real content).
         Font files are kept in Assets/Fonts and this resource is kept defined so the
         issue can be investigated later; nothing below references it right now. -->
    <FontFamily x:Key="ArabicFontFamily">avares://RealEstateInstallmentsManager/Assets/Fonts#IBM Plex Sans Arabic</FontFamily>
   </Application.Resources>

   <Application.Styles>
    <FluentTheme />

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Visual identity: palette, chips, nav bar and card styles. -->
    <StyleInclude Source="avares://RealEstateInstallmentsManager/Main/Theme.axaml"/>

    <!-- Reverted to Arial: IBM Plex Sans Arabic crashed the app on startup (see the
         comment on ArabicFontFamily above). Kept the broader ":is()" selectors, which
         also reach Button/TextBox text that "Arial"-on-TextBlock-only never did. -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>

    <!-- App-wide background (every native Window: the main window and every popup
         add/edit window), replacing the default white/system color. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
    </Style>
</Application.Styles>
</Application>
