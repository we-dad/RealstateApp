<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealEstateInstallmentsManager.App"
             RequestedThemeVariant="Light">
             <!-- Pinned to Light: the palette in Main/Theme.axaml (light backgrounds, dark
                  ink text) is designed for Light mode only. "Default" follows the OS theme,
                  which mixed our light colors with FluentTheme's dark-mode controls (buttons,
                  text boxes, DataGrid...) on a Mac set to Dark Mode. A real Dark variant is a
                  separate task (a second palette + a way to switch), not done yet. -->

   <Application.Resources>
    <!-- IBM Plex Sans Arabic, attempt 4 - found the real bug.
         Attempts 1-3 all guessed at the "#Name" URI syntax (folder vs. file, one
         weight vs. four), but the actual cause was simpler and was there the whole
         time: RealEstateInstallmentsManager.csproj never had an AvaloniaResource
         entry for Assets/Fonts, so EVERY avares://.../Assets/Fonts/... URI pointed
         at a folder Avalonia had never embedded - zero font files, in every attempt.
         (Confirmed by inspecting obj/Debug/net10.0/Avalonia/resources: no .ttf ever
         appeared in the embedded resource list, not even attempt 1's.) That explains
         why attempt 2/3 threw a clean "Could not create glyphTypeface" - no file to
         find - and it's the most likely explanation for attempt 1's native crash too:
         Avalonia's font fallback path hitting the same "nothing here" case, but
         through a different, uglier internal path when a whole family is requested
         instead of one exact typeface.
         Fix: added <AvaloniaResource Include="Assets\Fonts\**" /> to the .csproj.
         This build still targets ONLY the single-file Regular folder (the exact
         same target as attempt 3) - on purpose, to change one variable at a time:
         confirm the embedding fix alone makes this work before trying the full
         4-weight family again. FontWeight="Bold" still falls back to Avalonia's
         synthetic (faux) bold on this one face. Not yet tested. -->
    <FontFamily x:Key="ArabicFontFamily">avares://RealEstateInstallmentsManager/Assets/Fonts/Regular#IBM Plex Sans Arabic</FontFamily>
   </Application.Resources>

   <Application.Styles>
    <FluentTheme />

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Visual identity: palette, chips, nav bar and card styles. -->
    <StyleInclude Source="avares://RealEstateInstallmentsManager/Main/Theme.axaml"/>

    <!-- IBM Plex Sans Arabic, now with the font file actually embedded (see the
         comment on ArabicFontFamily above). UNTESTED - the developer must open the
         app and confirm it does not crash before this counts as working; if it still
         crashes, revert both Setters below to "Arial" the same way attempt 1 was. -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <!-- App-wide background (every native Window: the main window and every popup
         add/edit window), replacing the default white/system color. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
    </Style>
</Application.Styles>
</Application>
