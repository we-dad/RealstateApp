<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealEstateInstallmentsManager.App"
             RequestedThemeVariant="Light">
             <!-- Pinned to Light: the palette in Main/Theme.axaml (light backgrounds, dark
                  ink text) is designed for Light mode only. "Default" follows the OS theme,
                  which mixed our light colors with FluentTheme's dark-mode controls (buttons,
                  text boxes, DataGrid...) on a Mac set to Dark Mode. A real Dark variant is a
                  separate task (a second palette + a way to switch), not done yet. -->

   <Application.Resources>
    <!-- Attempt 3 at IBM Plex Sans Arabic.
         Attempt 1: the "#Name" syntax pointed at Assets/Fonts (4 weight files grouped
         under one family) - loaded fine, then crashed Avalonia's text shaper at first
         render (SIGABRT in TextFormatterImpl.ShapeTextRuns).
         Attempt 2: pointed "#Name" directly at one .ttf FILE instead of a folder, to
         test with only Regular - Avalonia does not support that form at all
         ("Could not create glyphTypeface", a clean managed exception, not a crash).
         Attempt 3 (this one): a real folder (Assets/Fonts/Regular) containing only the
         Regular file, still referenced as a folder (the syntax that actually loads),
         to properly test the single-file hypothesis this time.
         FontWeight="Bold" usages fall back to Avalonia's synthetic (faux) bold on this
         one face - close enough, not a real second weight file. Not yet tested. -->
    <FontFamily x:Key="ArabicFontFamily">avares://RealEstateInstallmentsManager/Assets/Fonts/Regular#IBM Plex Sans Arabic</FontFamily>
   </Application.Resources>

   <Application.Styles>
    <FluentTheme />

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Visual identity: palette, chips, nav bar and card styles. -->
    <StyleInclude Source="avares://RealEstateInstallmentsManager/Main/Theme.axaml"/>

    <!-- Trying IBM Plex Sans Arabic again, single-file this time (see the comment on
         ArabicFontFamily above). UNTESTED - the developer must open the app and confirm
         it does not crash before this counts as working; if it still crashes, revert
         both Setters below to "Arial" the same way the first attempt was reverted. -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFontFamily}"/>
    </Style>

    <!-- App-wide background (every native Window: the main window and every popup
         add/edit window), replacing the default white/system color. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
    </Style>
</Application.Styles>
</Application>
