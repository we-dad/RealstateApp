<UserControl
    x:Class="RealEstateInstallmentsManager.Views.TopBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia">

    <!-- Deliberately no root FlowDirection="RightToLeft" here: this bar's layout
         is simple enough to just place columns in their real physical order
         directly (same technique as ReceiptViewInstallment), avoiding the whole
         "everything gets mirrored, alignment values flip meaning" class of bug
         found and fixed on the login screen. Column 0 = physical left (status/
         identity/logout), column 2 = physical right (brand), matching the
         reference design's top bar. -->
    <Border Background="{DynamicResource BrushInk}" Height="64" Padding="22,0">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                <Button x:Name="LogoutButton" Classes="navHome"
                        ToolTip.Tip="تسجيل خروج" Click="Logout_Click">
                    <Viewbox Width="16" Height="16" FlowDirection="LeftToRight">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource Icon.Logout}" Stroke="#E6ECF5" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>


                <!-- HorizontalAlignment="Right" here is literal/safe: this bar has
                     no ambient FlowDirection="RightToLeft" anywhere, so none of the
                     mirroring caveats documented on the login screen apply. -->
                <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" HorizontalAlignment="Right"
                               FontWeight="Bold" FontSize="13" Foreground="White"/>
                    <TextBlock x:Name="UserRoleText" HorizontalAlignment="Right"
                               FontSize="12" Foreground="{DynamicResource BrushMutedOnDark}"/>
                </StackPanel>

                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrushGoldSoft}">
                    <TextBlock x:Name="AvatarText" Text="؟" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource BrushGold}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Real online/offline check (ConnectivityService), same as the
                     login screen - never a fabricated "last synced at" time,
                     since no such tracking exists in the sync code. -->


                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnText" Text="جارٍ التحقق..." FontSize="12.5"
                               Foreground="{DynamicResource BrushMutedOnDark}"/>
                    <Border x:Name="ConnDot" Width="8" Height="8" CornerRadius="4"
                            Background="{DynamicResource BrushMuted}"/>
                </StackPanel>

            </StackPanel>

            <!-- Column 1: a module's own nav tabs go here (e.g. MainWindowInstallment's
                 "الإحصائيات/الملاك/العملاء/..."). Declared as a plain ContentControl -
                 the consuming screen builds/keeps its own tab Buttons (with their own
                 x:Name and Click wiring, untouched) and reparents that panel here via
                 the public NavSlot property, instead of this file knowing about any
                 specific module's tabs. Empty (collapses to nothing) for screens that
                 don't set it, like the module picker. -->
            <ContentControl x:Name="NavSlotInternal" Grid.Column="1" VerticalAlignment="Center"/>

            <!-- Real horizontal lockup logo (name + mark in one file) - matches
                 the reference design's own <img> exactly (height 44, width auto
                 at the file's own 2964.47:556.80 aspect ratio -> ~234 wide). No
                 separate text needed; the logo file already contains the name.
                 The reference design's own .brand rule adds a vertical divider
                 between the logo and the nav tabs (border-left:1px solid
                 #1D3A66; padding-left:18px) - added here the same way, on the
                 physical-left edge of this Button (the side facing the tabs,
                 since this bar places physical sides directly, no RTL mirroring). -->
            <Button Grid.Column="2" Click="Brand_Click"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BrushLineOnDark}" BorderThickness="1,0,0,0"
                    Padding="18,0,0,0"
                    ToolTip.Tip="الرئيسية">
                <svg:Svg Width="234" Height="44" FlowDirection="LeftToRight"
                         Path="avares://RealEstateInstallmentsManager/Assets/Logo/lockup-horizontal-dark.svg"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
