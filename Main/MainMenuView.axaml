<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:RealEstateInstallmentsManager.Views"
    x:Class="RealEstateInstallmentsManager.Views.MainMenuView"
    x:DataType="views:MainMenuView">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            IsVisible="{Binding IsTester}"
            FlowDirection="RightToLeft"
            Background="#FFF3CD"
            BorderBrush="#E0C36A"
            BorderThickness="1"
            CornerRadius="6"
            Margin="20,20,20,0"
            Padding="16,10"
            MaxWidth="700"
            HorizontalAlignment="Center">
            <TextBlock
                Text="هذا حساب تجريبي، ولا يعرض البيانات المخزّنة على السحابة. للحصول على الصلاحية تواصل مع المسؤول."
                Foreground="#664D03"
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Center"/>
        </Border>

        <TextBlock
            Grid.RowSpan="2"
            Text="{ReflectionBinding AppVersion}"
            FontSize="16"
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"/>
  
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="200">

            <TextBlock
                Text="المسار الذهبي"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

         <StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Center"
    Spacing="30">

    <Button Width="220"
            Height="220"
            Content="إدارة التقسيط"
            FontSize="28"
            Click="InstallmentButton_Click"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>

    <Button Width="220"
            Height="220"
            Content="إدارة العقارات"
            FontSize="28"
            Click="RealEstateButton_Click"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>
</StackPanel>
        </StackPanel>
    </Grid>
</UserControl>