<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:RealEstateInstallmentsManager.Views"
    x:Class="RealEstateInstallmentsManager.Views.MainMenuView"
    x:DataType="views:MainMenuView">

    <!-- No root FlowDirection="RightToLeft" here either (see TopBarView's own
         comment) - text alignment is set explicitly per element instead. -->
    <DockPanel Background="{DynamicResource BrushBg}">

        <views:TopBarView x:Name="TopBar" DockPanel.Dock="Top"/>

        <Border
            DockPanel.Dock="Top"
            IsVisible="{Binding IsTester}"
            Background="#FFF3CD"
            BorderBrush="#E0C36A"
            BorderThickness="1"
            CornerRadius="6"
            Margin="20,16,20,0"
            Padding="16,10">
            <TextBlock
                Text="هذا حساب تجريبي، ولا يعرض البيانات المخزّنة على السحابة. للحصول على الصلاحية تواصل مع المسؤول."
                Foreground="#664D03"
                FontSize="14"
                TextWrapping="Wrap"
                TextAlignment="Center"/>
        </Border>

        <!-- VerticalAlignment="Center" on the inner Grid: the content is short
             relative to a maximized window, and was sitting pinned to the top
             with a lot of empty space below it - centering it in the remaining
             space (below the top bar) reads better. Still scrolls normally if
             the window is ever short enough that the content doesn't fit. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="24,40" RowSpacing="8"
                  VerticalAlignment="Center">

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="DateText" TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource BrushMuted}"/>
                    <TextBlock x:Name="GreetingText" TextAlignment="Center" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource BrushInk}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,32,0,0" ColumnDefinitions="*,*" ColumnSpacing="24"
                      HorizontalAlignment="Center" MaxWidth="1000">

                    <!-- Installment module - real numbers from DashboardServiceInstallment. -->
                    <Button Grid.Column="1" Classes="moduleCard" Click="InstallmentButton_Click"
                            Background="{DynamicResource BrushSurface}"
                            BorderThickness="1" CornerRadius="10" Padding="26" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource BrushGoldSoft}">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{DynamicResource Icon.Cards}" Stroke="{DynamicResource BrushGold}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="الأقساط" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushInk}" TextAlignment="Right"/>
                                    <TextBlock Text="عقود البيع بالتقسيط والتحصيل والملاك" FontSize="12.5"
                                               Foreground="{DynamicResource BrushMuted}" TextAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Classes="statGrid" ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" Classes="statCell"><StackPanel Spacing="4">
                                    <TextBlock Classes="statLabel" Text="عقود نشطة"/>
                                    <SelectableTextBlock x:Name="StatActiveContracts" Classes="statValue"/>
                                </StackPanel></Border>
                                <Border Grid.Column="1" Classes="statCell"><StackPanel Spacing="4">
                                    <TextBlock Classes="statLabel" Text="متأخرات"/>
                                    <SelectableTextBlock x:Name="StatArrears" Classes="statValue"
                                                          Foreground="{DynamicResource BrushLate}"/>
                                </StackPanel></Border>
                                <Border Grid.Column="2" Classes="statCell"><StackPanel Spacing="4">
                                    <TextBlock Classes="statLabel" Text="مستحق خلال 7 أيام"/>
                                    <SelectableTextBlock x:Name="StatDueSoon" Classes="statValue"/>
                                </StackPanel></Border>
                            </Grid>

                        </StackPanel>
                    </Button>

                    <!-- Real estate module - stats are placeholders on purpose:
                         no equivalent dashboard query exists yet for this module. -->
                    <Button Grid.Column="0" Classes="moduleCard" Click="RealEstateButton_Click"
                            Background="{DynamicResource BrushSurface}"
                            BorderThickness="1"
                            CornerRadius="10" Padding="26" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource BrushBg}"
                                        BorderBrush="{DynamicResource BrushLine}" BorderThickness="1">
                                    <Viewbox Width="26" Height="26">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{DynamicResource Icon.Building}" Stroke="{DynamicResource BrushInk}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="العقارات" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushInk}" TextAlignment="Right"/>
                                    <TextBlock Text="الوحدات والمستأجرين وعقود الإيجار" FontSize="12.5"
                                               Foreground="{DynamicResource BrushMuted}" TextAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Classes="statGrid" ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" Classes="statCell"><StackPanel Spacing="4">
                                    <TextBlock Classes="statLabel" Text="الوحدات"/>
                                    <TextBlock Classes="statValue" Text="—" Foreground="{DynamicResource BrushMuted}"/>
                                </StackPanel></Border>
                                <Border Grid.Column="1" Classes="statCell"><StackPanel Spacing="4">
                                    <TextBlock Classes="statLabel" Text="متأخرات الإيجار"/>
                                    <TextBlock Classes="statValue" Text="—" Foreground="{DynamicResource BrushMuted}"/>
                                </StackPanel></Border>
                                <Border Grid.Column="2" Classes="statCell"><StackPanel Spacing="4">
                                    <TextBlock Classes="statLabel" Text="عقود تنتهي قريبًا"/>
                                    <TextBlock Classes="statValue" Text="—" Foreground="{DynamicResource BrushMuted}"/>
                                </StackPanel></Border>
                            </Grid>

                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="2" Text="{ReflectionBinding AppVersion}" FontSize="11"
                           Foreground="{DynamicResource BrushMuted}"
                           Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
