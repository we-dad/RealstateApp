<UserControl
    x:Class="RealEstateInstallmentsManager.Views.SplashView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shown only for the moment it takes to check for a saved "تذكرني" session
         at startup, so the developer never sees a flash of the full login form
         (fields, buttons...) before an auto-login redirects away from it. -->
    <Border Background="{DynamicResource BrushInk}">
        <TextBlock Text="المسار الذهبي" FontSize="22" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</UserControl>
