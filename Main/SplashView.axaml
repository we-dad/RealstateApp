<UserControl
    x:Class="RealEstateInstallmentsManager.Views.SplashView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia">

    <!-- Shown only for the moment it takes to check for a saved "تذكرني" session
         at startup, so the developer never sees a flash of the full login form
         (fields, buttons...) before an auto-login redirects away from it.
         ProgressBar IsIndeterminate="True" for the loading animation - Avalonia's
         own built-in indeterminate animation, not a hand-rolled one.
         Vertical lockup logo instead of plain text - matches the logo kit's own
         README guidance table ("شاشة الدخول / شاشة البداية" -> lockup-vertical). -->
    <Border Background="{DynamicResource BrushInk}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
            <svg:Svg Width="180" Height="154" FlowDirection="LeftToRight"
                     Path="avares://RealEstateInstallmentsManager/Assets/Logo/lockup-vertical-dark.svg"/>
            <ProgressBar IsIndeterminate="True" Width="160" Height="4"
                         Background="{DynamicResource BrushLineOnDark}" Foreground="{DynamicResource BrushGold}"/>
        </StackPanel>
    </Border>
</UserControl>
