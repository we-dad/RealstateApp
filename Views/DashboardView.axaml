<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:models="clr-namespace:RealEstateApp.Models"
             x:Class="RealEstateApp.Views.DashboardView"
             FlowDirection="LeftToRight">

  <ScrollViewer>
    <StackPanel Spacing="12" Margin="16">

      <!-- Styles عامة (عربي بدون قلب الشارت) -->
      <StackPanel.Styles>
        <Style Selector="TextBlock">
          <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBox">
          <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="ComboBox">
          <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
          <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- تحسين بسيط للبطاقات -->
        <Style Selector="Border.card">
          <Setter Property="CornerRadius" Value="12"/>
          <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Border.smallcard">
          <Setter Property="CornerRadius" Value="12"/>
          <Setter Property="Padding" Value="8"/>
        </Style>
      </StackPanel.Styles>

      <!-- Top bar: السنة يمين + زر يسار -->
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="السنة:" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="YearCombo" Width="140"/>
        <Button Grid.Column="2" x:Name="RefreshBtn" Content="تحديث" HorizontalAlignment="Left"/>
      </Grid>

      <!-- ✅ شريط العدادات الصغير فوق -->
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">

        <Border Classes="smallcard" Grid.Column="0">
          <StackPanel Spacing="2">
            <TextBlock Text="الملاك" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="OwnersCountText" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="smallcard" Grid.Column="1">
          <StackPanel Spacing="2">
            <TextBlock Text="الوحدات" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="UnitsCountText" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="smallcard" Grid.Column="2">
          <StackPanel Spacing="2">
            <TextBlock Text="المستأجرين" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="TenantsCountText" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="smallcard" Grid.Column="3">
          <StackPanel Spacing="2">
            <TextBlock Text="العقود" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="ContractsCountText" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="smallcard" Grid.Column="4">
          <StackPanel Spacing="2">
            <TextBlock Text="سندات القبض" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="ReceiptsCountText" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
        </Border>

      </Grid>

      <!-- KPI cards -->
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">

        <Border Classes="card" Grid.Column="0">
          <StackPanel Spacing="3">
            <TextBlock Text="إجمالي القبض" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="TotalReceiptsText" FontSize="20" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="3">
            <TextBlock Text="إجمالي الصرف" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="TotalExpensesText" FontSize="20" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="2">
          <StackPanel Spacing="3">
            <TextBlock Text="الصافي" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="NetText" FontSize="20" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="3">
          <StackPanel Spacing="3">
            <TextBlock Text="مؤجر" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="RentedText" FontSize="20" FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Classes="card" Grid.Column="4">
          <StackPanel Spacing="3">
            <TextBlock Text="شاغر" FontSize="12" Opacity="0.85"/>
            <TextBlock x:Name="VacantText" FontSize="20" FontWeight="Bold"/>
          </StackPanel>
        </Border>

      </Grid>

      <!-- ✅ الرسومات أصغر ومناسبة -->
      <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">

        <!-- Line (يسار) -->
        <Border Classes="card" Grid.Column="0">
          <StackPanel Spacing="6">
            <TextBlock Text="القبض والصرف (شهريًا)" FontSize="13"/>
            <lvc:CartesianChart x:Name="MonthlyChart" Height="220"/>
          </StackPanel>
        </Border>

        <!-- Pie (يمين) -->
        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="6">
            <TextBlock Text="نسبة الإشغال" FontSize="13"/>
            <lvc:PieChart x:Name="OccupancyChart" Height="220"/>
          </StackPanel>
        </Border>

      </Grid>

      <!-- Top 5 units chart أصغر -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="أعلى 5 وحدات دخلاً (حسب السنة)" FontSize="13"/>
          <lvc:CartesianChart x:Name="TopUnitsChart" Height="210"/>
        </StackPanel>
      </Border>

      <!-- Units stats table -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="إحصائيات الوحدات حسب السنة" FontSize="13"/>

          <DataGrid x:Name="UnitsStatsGrid"
                    AutoGenerateColumns="False"
                    Height="260"
                    FlowDirection="RightToLeft">

            <DataGrid.Columns>

              <DataGridTemplateColumn Header="الوحدة" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="models:UnitYearStatRow">
                    <TextBlock Text="{Binding UnitName}" TextAlignment="Right"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="عدد مرات التأجير" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="models:UnitYearStatRow">
                    <TextBlock Text="{Binding ContractsStartedThisYear}" TextAlignment="Right"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="إجمالي المقبوضات" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="models:UnitYearStatRow">
                    <TextBlock Text="{Binding ReceiptsTotalThisYear}" TextAlignment="Right"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </DataGrid.Columns>
          </DataGrid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>