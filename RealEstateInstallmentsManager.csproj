<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <ApplicationManifest>Main/app.manifest</ApplicationManifest>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AssemblyName>RealEstateInstallmentsManager</AssemblyName>
    <Product>المسار الذهبي</Product>
    <Title>المسار الذهبي</Title>

    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaApplicationIcon>Assets/app.icns</AvaloniaApplicationIcon>

    <Version>1.0.31</Version>
    <AssemblyVersion>1.0.31.0</AssemblyVersion>
    <FileVersion>1.0.31.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc6.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.2" />
    <PackageReference Include="QuestPDF" Version="2025.12.3" />
    <PackageReference Include="supabase-csharp" Version="0.16.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real cause of every "IBM Plex Sans Arabic" crash/exception so far: this
         project never had an AvaloniaResource entry for the font files, so every
         avares://.../Assets/Fonts/... URI pointed at an empty resource folder - not
         a syntax problem with folders vs. files or with grouping multiple weights.
         Broadened to all of Assets/ (not just Fonts) so the same silent-empty-folder
         bug can't recur for any future asset (e.g. Assets/Logo/logo-mark.svg). -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="RealEstate\Views\ContractsViewRealEstate.axaml.cs">
      <DependentUpon>InstallmentContractsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="RealEstate\Views\OwnersViewRealEstate.axaml.cs">
      <DependentUpon>InstallmentOwnersView.axaml</DependentUpon>
    </Compile>
    <Compile Update="RealEstate\Views\DashboardViewRealEstate.axaml.cs">
      <DependentUpon>InstallmentDashboardView.axaml</DependentUpon>
    </Compile>
    <Compile Update="RealEstate\Views\OwnersWindowViewRealEstate.axaml.cs">
      <DependentUpon>InstallmentOwnersWindowView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Installment\Views\ReceiptWindowViewInstallment.axaml.cs">
      <DependentUpon>ReceiptWindowViewInstallment.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
