<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateApp.Models"
        x:Class="RealEstateApp.Views.ReceiptsWindowView"
        x:DataType="models:Receipt"
        Title="معلومات سند القبض"
        Width="700"
        Height="750">

    <Grid RowDefinitions="Auto,*" Margin="6">

        <Border Padding="12" CornerRadius="12">
            <StackPanel Spacing="8">
                <TextBlock Text="سند القبض" FontSize="18" TextAlignment="Right"/>
                <Button Click="Print_Click"
                        ToolTip.Tip="طباعة السند"
                        Width="36"
                        Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="16">
                    🖨️
                </Button>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"                      ColumnSpacing="10"
                      RowSpacing="8">

                    <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ReceiptNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                    <DatePicker x:Name="ReceiptDate" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                    <TextBlock Text="المبلغ"
                               Grid.Row="2"
                               Grid.Column="0"
                               TextAlignment="Right"/>

                    <TextBox x:Name="AmountBox"
                             Grid.Row="3"
                             Grid.Column="0"
                             TextAlignment="Right"
                             MaxHeight="32"
                             VerticalAlignment="Top"/>

                    <TextBlock Text="رقم العقد"
                               Grid.Row="2"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <Grid Grid.Row="3"
                          Grid.Column="1"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowSpacing="4">

                        <Button Content="بحث"
                                Grid.Row="0"
                                Grid.Column="0"
                                Click="SearchContract_Click"/>

                        <TextBox x:Name="ContractNumSearchBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Right"
                                 Watermark="اكتب رقم العقد"/>

                        <TextBlock x:Name="ContractInfoText"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   TextAlignment="Right"
                                   Foreground="Green"/>
                    </Grid>

                    <TextBlock Text="طريقة الدفع" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <ComboBox x:Name="PaymentMethodBox"
                              Grid.Row="5"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>



                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="حذف البيانات" Click="Delete_Click"/>
                    <Button Content="تحديث البيانات" Click="Update_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="12" CornerRadius="12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="10">

                    <!-- Receipt Info -->
                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="بيانات سند القبض" HorizontalAlignment="Right"/>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="8">

                                <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultReceiptNumBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="تاريخ السند" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultReceiptDateBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="مبلغ السند" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultAmountBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="طريقة الدفع" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultPaymentMethodBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Contract Info -->
                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="بيانات العقد" HorizontalAlignment="Right"/>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="8">

                                <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultContractNumBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="تاريخ بدء العقد" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultContractDateStartBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="تاريخ انتهاء العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultContractDateEndBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="مبلغ الإيجار" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultRentAmountBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Unit Info -->
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="بيانات الوحدة" HorizontalAlignment="Right"/>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="8">

                                <TextBlock Text="اسم الوحدة" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultUnitNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="الحي" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultDistrictBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="المدينة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultCityBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="نوع الوحده" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultUnitTypeBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="رقم الوحدة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultUnitNumBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Owner Info -->
                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="بيانات المالك" HorizontalAlignment="Right"/>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="8">

                                <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultOwnerNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultOwnerIdentityNumberBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultOwnerPhoneBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultOwnerAddressBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tenant Info -->
                    <Border Grid.Row="2" Grid.Column="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="بيانات المستأجر" HorizontalAlignment="Right"/>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="8">

                                <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultTenantNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultTenantIdentityNumberBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultTenantPhoneBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultTenantAddressBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </StackPanel>
        </Border>



    </Grid>
</Window>
