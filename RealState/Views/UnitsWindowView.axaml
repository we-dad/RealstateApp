<Window x:Class="RealEstateApp.Views.UnitsWindowView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateApp.Models"
        x:DataType="models:Unit"
        Title="معلومات الوحدة"
        Width="700"
        Height="700">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="6">

        <!-- Form -->
        <Border Padding="12" CornerRadius="12">
            <StackPanel Spacing="8">
                <TextBlock Text="الوحدات السكنية" FontSize="18" TextAlignment="Right"/>
                <Grid ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      HorizontalAlignment="Left">
                    <Border Grid.Column="0"
                            Background="{Binding StateColor}"
                            Padding="6,2"
                            MinWidth="60"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnitState}"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">

                    <TextBlock Text="اسم الوحدة" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                    <TextBox x:Name="UnitNameBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="المالك" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <ComboBox x:Name="OwnerBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Owner">
                                <TextBlock Text="{Binding Name}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="الحي" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                    <TextBox x:Name="DistrictBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="المدينة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBox x:Name="CityBox" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="نوع الوحده" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                    <ComboBox x:Name="UnitTypeBox"
                              Grid.Row="5"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="رقم الوحدة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <StackPanel Grid.Row="5"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="6">

                        <TextBox x:Name="UnitsCountBox"
                                 Width="60"
                                 Text="1"
                                 TextAlignment="Right"/>

                        <TextBlock Text="/"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="UnitNumBox"
                                 Width="60"
                                 Text="1"
                                 TextAlignment="Right"/>

                    </StackPanel>


                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="حذف البيانات" Click="Delete_Click"/>
                    <Button Content="تحديث البيانات" Click="Update_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="12" Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات الوحدة" HorizontalAlignment="Right"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">

                    <TextBlock Text="اسم الوحدة" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultUnitNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="الحي" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultDistrictBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="المدينة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultCityBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="نوع الوحده" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultUnitTypeBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="رقم الوحدة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultUnitNumBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>

                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" CornerRadius="12" Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات المالك" HorizontalAlignment="Right"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">

                    <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultIdentityNumberBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultPhoneBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultAddressBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
