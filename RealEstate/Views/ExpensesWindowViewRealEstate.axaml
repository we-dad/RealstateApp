<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ExpensesWindowViewRealEstate"
        x:DataType="models:ExpensesRealEstate"
        Title="معلومات سند الصرف"
        Width="800"
        Height="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="12" Spacing="12">

            <Border Padding="12" CornerRadius="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0"
                                Click="Print_Click"
                                Tag="{Binding}"
                                ToolTip.Tip="طباعة سند الصرف"
                                Width="36"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="16">
                            🖨️
                        </Button>
                        <TextBlock Grid.Column="1" Text="المصروفات" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="رقم سند الصرف" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBlock x:Name="ExpensesNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <DatePicker x:Name="ExpensesDateBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="اسم الوحدة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="UnitsBox" Grid.Row="3" Grid.Column="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:UnitRealEstate">
                                    <TextBlock Text="{Binding UnitName}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="نوع الخدمة" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="ExpensesServiceBox"
                                  Grid.Row="3"
                                  Grid.Column="0"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="مبلغ الصرف" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="ExpensesAmountBox" Grid.Row="5" Grid.Column="1"
                                 TextAlignment="Right" VerticalAlignment="Top"/>

                        <TextBlock Text="الملاحظات" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="ExpensesNoteBox" Grid.Row="5" Grid.Column="0"
                                 TextAlignment="Right" VerticalAlignment="Top"/>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="بيانات الصرف"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="8"
                          FlowDirection="RightToLeft">

                        <TextBlock Text="رقم سند الصرف" Grid.Row="0" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultExpensesNumBox" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultExpensesDateBox" Grid.Row="0" Grid.Column="3"/>

                        <TextBlock Text="نوع الخدمة" Grid.Row="1" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultExpensesServiceBox" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="مبلغ الصرف" Grid.Row="1" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultExpensesAmountBox" Grid.Row="1" Grid.Column="3"/>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="الملاحظات" FontWeight="Bold" TextAlignment="Right"/>
                        <TextBlock x:Name="ResultExpensesNoteBox"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="انقر مرتين للفتح"
                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="بيانات الوحدة"
                                   FontSize="16" TextAlignment="Right"/>
                    </Grid>

                    <DataGrid x:Name="UnitDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              FlowDirection="RightToLeft"
                              Height="100"
                              DoubleTapped="UnitDataGrid_DoubleTapped">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الوحدة" Binding="{ReflectionBinding UnitName}" Width="1.5*"/>
                            <DataGridTextColumn Header="الحي" Binding="{ReflectionBinding District}" Width="*"/>
                            <DataGridTextColumn Header="المدينة" Binding="{ReflectionBinding City}" Width="*"/>
                            <DataGridTextColumn Header="نوع الوحدة" Binding="{ReflectionBinding UnitType}" Width="*"/>
                            <DataGridTextColumn Header="رقم الوحدة" Binding="{ReflectionBinding UnitNum}" Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>