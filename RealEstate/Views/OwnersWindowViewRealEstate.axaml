<Window x:Class="RealEstateInstallmentsManager.Views.OwnersWindowViewRealEstate"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معلومات المالك"
        Width="800"
        Height="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16" Spacing="10">

            <Border Padding="12" CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="المالك" FontSize="18" HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>

                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Content="حذف البيانات" Click="Delete_Click"/>
                            <Button Content="تحديث البيانات" Click="Update_Click"/>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Text="بيانات المالك"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          FlowDirection="RightToLeft">

                        <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="الاسم" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultNameBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="رقم الهوية" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultIdentityNumberBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="الجوال" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultPhoneBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="العنوان" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultAddressBox"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="وحدات المالك" FontSize="16" HorizontalAlignment="Right"/>

                    <DataGrid x:Name="UnitsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              CanUserSortColumns="True"
                              FlowDirection="RightToLeft"
                              Height="250">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الوحدة" Binding="{ReflectionBinding UnitName}" />
                            <DataGridTextColumn Header="المدينة" Binding="{ReflectionBinding City}" />
                            <DataGridTextColumn Header="الحي" Binding="{ReflectionBinding District}" />
                            <DataGridTextColumn Header="الحالة" Binding="{ReflectionBinding UnitState}" />
                            <DataGridTextColumn Header="النوع" Binding="{ReflectionBinding UnitType}" />
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>