<Window x:Class="RealEstateInstallmentsManager.Views.UnitsWindowViewRealEstate"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:DataType="models:UnitRealEstate"
        Title="معلومات الوحدة"
        Width="800"
        Height="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="6" Spacing="10">

            <Border Padding="12" CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="الوحدات السكنية" FontSize="18" TextAlignment="Right"/>

                    <Border Background="{Binding StateColor}"
                            Padding="6,2"
                            MinWidth="60"
                            CornerRadius="4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding UnitState}"
                                   Foreground="White"
                                   TextAlignment="Center"/>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="اسم الوحدة" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="UnitNameBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="المالك" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="OwnerBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:OwnerRealEstate">
                                    <TextBlock Text="{Binding Name}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="الحي" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="DistrictBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="المدينة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="CityBox" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="نوع الوحدة" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="UnitTypeBox"
                                  Grid.Row="5"
                                  Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="رقم الوحدة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                        <StackPanel Grid.Row="5"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                            <TextBox x:Name="UnitsCountBox" Width="60" Text="1" TextAlignment="Right"/>
                            <TextBlock Text="/" VerticalAlignment="Center"/>
                            <TextBox x:Name="UnitNumBox" Width="60" Text="1" TextAlignment="Right"/>
                        </StackPanel>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Text="بيانات الوحدة"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          FlowDirection="RightToLeft">

                        <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="اسم الوحدة" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultUnitNameBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="الحالة" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock Text="{Binding UnitState}" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="الحي" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultDistrictBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="المدينة" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultCityBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="نوع الوحدة" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultUnitTypeBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="رقم الوحدة" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultUnitNumBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="بيانات المالك"
                               FontSize="16"
                               HorizontalAlignment="Right"/>

                    <DataGrid x:Name="OwnerDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              FlowDirection="RightToLeft"
                              Height="120"
                              DoubleTapped="OwnerDataGrid_DoubleTapped">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding OwnerName}" Width="160"/>
                            <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding OwnerIdentityNumber}" Width="160"/>
                            <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding OwnerPhone}" Width="140"/>
                            <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding OwnerAddress}" Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="العقود"
                               FontSize="16"
                               HorizontalAlignment="Right"/>

                    <DataGrid x:Name="ContractsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              CanUserSortColumns="True"
                              FlowDirection="RightToLeft"
                              Height="220"
                              DoubleTapped="ContractsGrid_DoubleTapped">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العقد" Binding="{ReflectionBinding ContractNumber}" />
                            <DataGridTextColumn Header="المستأجر" Binding="{ReflectionBinding TenantName}" />
                            <DataGridTextColumn Header="بداية العقد" Binding="{ReflectionBinding ContractStartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="160" />
                            <DataGridTextColumn Header="نهاية العقد" Binding="{ReflectionBinding ContractEndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="160" />
                            <DataGridTextColumn Header="الإيجار" Binding="{ReflectionBinding RentAmount}" />
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{ReflectionBinding ContractPayMethod}" />
                            <DataGridTextColumn Header="الحالة" Binding="{ReflectionBinding ContractState}" />
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>