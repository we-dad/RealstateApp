<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.ReceiptsViewRealEstate"
             x:DataType="models:ReceiptRealEstate">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="12" Spacing="12">

            <Border Padding="12" CornerRadius="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="سند القبض" FontSize="18" TextAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBlock x:Name="ReceiptNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <TextBlock x:Name="ReceiptDate" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="المبلغ" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="AmountBox"
                                 Grid.Row="3"
                                 Grid.Column="0"
                                 TextAlignment="Right"
                                 MaxHeight="32"
                                 VerticalAlignment="Top"/>

                        <TextBlock Text="رقم العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="3"
                              Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              RowSpacing="4">

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        FlowDirection="RightToLeft">

                                <TextBox x:Name="ContractNumSearchBox"
                                         Width="160"
                                         TextAlignment="Right"
                                         Watermark="اكتب رقم العقد"/>

                                <TextBlock Text="Rc-"
                                           VerticalAlignment="Center"/>

                                <Button Content="بحث"
                                        Click="SearchContract_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="طريقة الدفع" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="PaymentMethodBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock x:Name="ContractInfoText"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   FontSize="16"/>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="تحديث" Click="Refresh_Click"/>
                        <Button Content="إضافة" Click="Add_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border CornerRadius="12"
                    Padding="12"
                    BorderBrush="#DDD" BorderThickness="1">

                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="انقر مرتين على السند لفتح التفاصيل"
                                   FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="قائمة السندات"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="ReceiptsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              x:DataType="models:ReceiptRealEstate"
                              FlowDirection="RightToLeft"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              Height="430"
                              DoubleTapped="ReceiptsGrid_DoubleTapped">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Id}"
                                                Width="60"/>

                            <DataGridTextColumn Header="اسم المستأجر"
                                                Binding="{Binding TenantName}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="رقم السند"
                                                Binding="{Binding ReceiptNumber}"
                                                Width="*"/>

                            <DataGridTextColumn Header="تاريخ السند"
                                                Binding="{Binding ReceiptDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                Width="*"/>

                            <DataGridTextColumn Header="رقم العقد"
                                                Binding="{Binding ContractNumber}"
                                                Width="*"/>

                            <DataGridTextColumn Header="المبلغ"
                                                Binding="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                Width="*"/>

                            <DataGridTemplateColumn Header="طباعة" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="Print_Click"
                                                Tag="{Binding}"
                                                ToolTip.Tip="طباعة السند"
                                                Width="36"
                                                Height="32"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontSize="16">
                                            🖨️
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>