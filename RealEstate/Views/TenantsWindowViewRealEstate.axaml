<Window x:Class="RealEstateInstallmentsManager.Views.TenantsWindowViewRealEstate"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:DataType="models:TenantRealEstate"
        Title="معلومات المستأجر"
        Width="850"
        Height="750">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16" Spacing="10">

            <Border Padding="12" CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="المستأجر" FontSize="18" HorizontalAlignment="Right"/>

                    <Button Content="طباعة السجل المالي"
                            HorizontalAlignment="Left"
                            Click="PrintAllReceipts_Click"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>

                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">

                            <Button Content="حذف البيانات" Click="Delete_Click"/>
                            <Button Content="تحديث البيانات" Click="Update_Click"/>

                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12"
                    Padding="12">

                <StackPanel Spacing="10">

                    <TextBlock Text="بيانات المستأجر"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          FlowDirection="RightToLeft">

                        <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="الاسم" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultNameBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="رقم الهوية" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultIdentityNumberBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="الجوال" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultPhoneBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="العنوان" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultAddressBox"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                <Border Grid.Column="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="العقود" FontSize="18" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="TenantContractsGrid"
                                  x:CompileBindings="False"
                                  FlowDirection="RightToLeft"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="250"
                                  GridLinesVisibility="All"
                                  CanUserSortColumns="True"
                                  DoubleTapped="TenantContractsGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}"/>
                                <DataGridTextColumn Header="البداية" Binding="{Binding ContractStartDate, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                <DataGridTextColumn Header="النهاية" Binding="{Binding ContractEndDate, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                <DataGridTextColumn Header="الإيجار" Binding="{Binding RentAmount}"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding ContractState}"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="سندات القبض" FontSize="18" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="TenantReceiptsGrid"
                                  x:CompileBindings="False"
                                  FlowDirection="RightToLeft"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="250"
                                  GridLinesVisibility="All"
                                  CanUserSortColumns="True"
                                  DoubleTapped="TenantReceiptsGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم السند" Binding="{Binding ReceiptNumber}"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding ReceiptDate, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding ReceiptAmount}"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>