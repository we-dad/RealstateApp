<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.OwnersViewRealEstate"
             x:DataType="models:OwnerRealEstate">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="6" Spacing="10">

            <Border Padding="12" CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="الملاك" FontSize="18" HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                        <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>

                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Content="تحديث" Click="Refresh_Click"/>
                            <Button Content="إضافة" Click="Add_Click"/>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12"
                    Padding="12">

                <StackPanel Spacing="8">

                    <TextBlock Text="قائمة الملاك"
                               HorizontalAlignment="Right"/>

                    <DataGrid x:Name="OwnersGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              x:DataType="models:OwnerRealEstate"
                              FlowDirection="RightToLeft"
                              HorizontalAlignment="Stretch"
                              Height="420"
                              DoubleTapped="OwnersGrid_DoubleTapped">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Id}"
                                                Width="80"/>

                            <DataGridTextColumn Header="الاسم"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="رقم الهوية"
                                                Binding="{Binding IdentityNumber}"
                                                Width="200"/>

                            <DataGridTextColumn Header="الجوال"
                                                Binding="{Binding Phone}"
                                                Width="200"/>

                            <DataGridTextColumn Header="العنوان"
                                                Binding="{Binding Address}"
                                                Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>