<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ContractsWindowViewRealEstate"
        x:DataType="models:ContractRealEstate"
        Title="معلومات العقد"
        Width="900"
        Height="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="6" Spacing="10">

            <Border Padding="12" CornerRadius="12">
                <StackPanel Spacing="8">

                    <TextBlock Text="عقد الإيجار" FontSize="18" TextAlignment="Right"/>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="8"
                          HorizontalAlignment="Left">

                        <!-- Print -->
                        <Button Grid.Column="0"
                                Click="Print_Click"
                                ToolTip.Tip="طباعة العقد"
                                Width="36"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="16">
                            🖨️
                        </Button>

                        <!-- Upload -->
                        <Button Grid.Column="1"
                                Content="📎"
                                Tag="{Binding}"
                                Click="UploadSignature_Click"
                                Width="36"
                                Height="32"
                                Padding="0"
                                FontSize="16"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{Binding SignatureButton}"
                                ToolTip.Tip="رفع ملف العقد"/>

                        <!-- Open -->
                        <Button Grid.Column="2"
                                Content="👁"
                                Tag="{Binding}"
                                Click="OpenSignature_Click"
                                Width="36"
                                Height="32"
                                Padding="0"
                                FontSize="16"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="فتح ملف العقد"/>

                        <!-- State -->
                        <Border Grid.Column="3"
                                Background="{Binding StateColor}"
                                Padding="8,2"
                                MinWidth="60"
                                CornerRadius="4"
                                VerticalAlignment="Center">

                            <TextBlock Text="{Binding ContractState}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>

                        </Border>

                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" RowSpacing="8">

                        <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="ContractNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="تاريخ بدء العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <DatePicker x:Name="ContractDateStartPicker" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"/>

                        <TextBlock Text="تاريخ انتهاء العقد" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <DatePicker x:Name="ContractDateEndPicker" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="اسم الوحدة" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="UnitsBox" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:UnitRealEstate">
                                    <TextBlock Text="{Binding UnitName}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="هوية المستأجر" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="5" Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              RowSpacing="4">

                            <Button Content="بحث" Grid.Row="0" Grid.Column="0" Click="SearchTenant_Click"/>

                            <TextBox x:Name="TenantIdSearchBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     TextAlignment="Right"
                                     Watermark="اكتب رقم الهوية"/>

                            <TextBlock x:Name="TenantInfoText"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       TextAlignment="Right"
                                       Foreground="Green"/>
                        </Grid>

                        <TextBlock Text="مبلغ الإيجار" Grid.Row="6" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="RentAmountBox" Grid.Row="7" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="طريقة الدفع" Grid.Row="6" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="ContractPayMethodBox"
                                  Grid.Row="7"
                                  Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  FlowDirection="RightToLeft">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="نوع الشقة" Grid.Row="8" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="ContractApartmentTypeBox"
                                  Grid.Row="9"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="الإلتزامات" Grid.Row="8" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="ContractObligationsBox"
                                  Grid.Row="9"
                                  Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="تفاصيل الشقة" Grid.Row="10" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="11"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              ColumnDefinitions="Auto,Auto,Auto,Auto">

                            <TextBox x:Name="ContractUnitRoomsNumBox" Grid.Column="2" Width="55" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="3" Text="عدد الغرف" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <TextBox x:Name="ContractUnitFloorNumBox" Grid.Column="0" Width="55" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="عدد الأدوار" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

           <!-- Contract Data -->
<Border Grid.Row="0"
        Grid.ColumnSpan="2"
        CornerRadius="12"
        Padding="12">

    <StackPanel Spacing="10">

        <TextBlock Text="بيانات العقد"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Right"/>

        <Grid ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="20"
              RowSpacing="10"
              FlowDirection="RightToLeft">

            <!-- Row 1 -->
            <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="رقم العقد"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractNumBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="حالة العقد"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock Text="{Binding ContractState}"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Row 2 -->
            <Border Grid.Row="1" Grid.Column="0" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="تاريخ البداية"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractDateStartBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="تاريخ النهاية"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractDateEndBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Row 3 -->
            <Border Grid.Row="2" Grid.Column="0" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="الإيجار"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultRentAmountBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="طريقة الدفع"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractPayMethodBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Row 4 -->
            <Border Grid.Row="3" Grid.Column="0" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="نوع الوحدة"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractApartmentTypeBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="1" Padding="10" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="تفاصيل الوحدة"
                               FontWeight="Bold"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractUnitDetealsBox"
                               TextAlignment="Right"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Obligations -->
        <Border Padding="10"
                CornerRadius="8">

            <StackPanel Spacing="6">

                <TextBlock Text="الالتزامات"
                           FontWeight="Bold"
                           TextAlignment="Right"/>

                <TextBlock x:Name="ResultContractOpligationBox"
                           TextWrapping="Wrap"
                           TextAlignment="Right"/>

            </StackPanel>

        </Border>

    </StackPanel>

</Border>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">

                <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات الوحدة" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="UnitDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  DoubleTapped="UnitDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الوحدة" Binding="{ReflectionBinding UnitName}" Width="140"/>
                                <DataGridTextColumn Header="المدينة" Binding="{ReflectionBinding City}" Width="110"/>
                                <DataGridTextColumn Header="الحي" Binding="{ReflectionBinding District}" Width="110"/>
                                <DataGridTextColumn Header="نوع الوحدة" Binding="{ReflectionBinding UnitType}" Width="110"/>
                                <DataGridTextColumn Header="رقم الوحدة" Binding="{ReflectionBinding UnitNum}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات المالك" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="OwnerDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  DoubleTapped="OwnerDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding OwnerName}" Width="140"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding OwnerIdentityNumber}" Width="130"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding OwnerPhone}" Width="120"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding OwnerAddress}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات المستأجر" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="TenantDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  DoubleTapped="TenantDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding TenantName}" Width="160"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding TenantIdentityNumber}" Width="150"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding TenantPhone}" Width="140"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding TenantAddress}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Border Grid.Column="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="سندات القبض" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="ReceiptsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  CanUserSortColumns="True"
                                  FlowDirection="RightToLeft"
                                  Height="220"
                                  DoubleTapped="ReceiptsGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم السند" Binding="{ReflectionBinding ReceiptNumber}" Width="120"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{ReflectionBinding ReceiptDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="120"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{ReflectionBinding PaymentMethod}" Width="120"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{ReflectionBinding Amount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="المصروفات" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="ExpensesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  CanUserSortColumns="True"
                                  FlowDirection="RightToLeft"
                                  Height="220"
                                  DoubleTapped="ExpensesGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم المصروف" Binding="{ReflectionBinding ExpensesNumber}" Width="120"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{ReflectionBinding ExpensesDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="120"/>
                                <DataGridTextColumn Header="الخدمة" Binding="{ReflectionBinding ExpensesService}" Width="120"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{ReflectionBinding ExpensesAmount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>