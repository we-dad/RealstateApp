<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ContractsWindowViewRealEstate"
        x:DataType="models:ContractRealEstate"
        Title="معلومات العقد"
        Width="700"
        Height="850">

    <Grid Margin="6"
          RowDefinitions="Auto,Auto"
          RowSpacing="10">

        <Border Padding="12" CornerRadius="12">
            <StackPanel Spacing="8">
                <TextBlock Text="عقد الإيجار" FontSize="18" TextAlignment="Right"/>
                <Grid ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      HorizontalAlignment="Left">
                    <Border Grid.Column="1"
                            Background="{Binding StateColor}"
                            Padding="6,2"
                            MinWidth="60"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ContractState}"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="0"
                            Click="Print_Click"
                            ToolTip.Tip="طباعة العقد"
                            Width="36"
                            Height="32"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="16">
                        🖨️
                    </Button>

                </Grid>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ContractNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ بدء العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <DatePicker x:Name="ContractDateStartPicker" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"/>

                    <TextBlock Text="تاريخ انتهاء العقد" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                    <DatePicker x:Name="ContractDateEndPicker" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right"/>

                    <TextBlock Text="اسم الوحدة" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                    <ComboBox x:Name="UnitsBox" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:UnitRealEstate">
                                <TextBlock Text="{Binding UnitName}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="هوية المستأجر"
                               Grid.Row="4"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <Grid Grid.Row="5"
                          Grid.Column="1"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowSpacing="4">

                        <Button Content="بحث"
                                Grid.Row="0"
                                Grid.Column="0"
                                Click="SearchTenant_Click"/>

                        <TextBox x:Name="TenantIdSearchBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Right"
                                 Watermark="اكتب رقم الهوية"/>

                        <TextBlock x:Name="TenantInfoText"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   TextAlignment="Right"
                                   Foreground="Green"/>
                    </Grid>

                    <TextBlock Text="مبلغ الإيجار" Grid.Row="6" Grid.Column="1" TextAlignment="Right"/>
                    <TextBox x:Name="RentAmountBox" Grid.Row="7" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="طريقة الدفع"
                               Grid.Row="6"
                               Grid.Column="0"
                               TextAlignment="Right"
                               FlowDirection="RightToLeft"/>

                    <ComboBox x:Name="ContractPayMethodBox"
                              Grid.Row="7"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              FlowDirection="RightToLeft">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="نوع الشقة"
                               Grid.Row="8"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <ComboBox x:Name="ContractApartmentTypeBox"
                              Grid.Row="9"
                              Grid.Column="1"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="الإلتزامات"
                               Grid.Row="8"
                               Grid.Column="0"
                               TextAlignment="Right"/>

                    <ComboBox x:Name="ContractObligationsBox"
                              Grid.Row="9"
                              Grid.Column="0"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="تفاصيل الشقة"
                               Grid.Row="10"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <Grid Grid.Row="11"
                          Grid.Column="1"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          ColumnDefinitions="Auto,Auto, Auto,Auto"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="12">

                        <!-- الصف الأول -->
                        <TextBox x:Name="ContractUnitRoomsNumBox" Grid.Row="0" Grid.Column="2"
                                 Width="55"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="عدد الغرف"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <TextBox x:Name="ContractUnitFloorNumBox" Grid.Row="0" Grid.Column="0"
                                 Width="55"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="عدد الأدوار"
                                   VerticalAlignment="Center"/>
                    </Grid>

                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="حذف البيانات" Click="Delete_Click"/>
                    <Button Content="تحديث البيانات" Click="Update_Click"/>
                </StackPanel>

                <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                MaxHeight="320">

                    <Border Padding="12" CornerRadius="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="10">

                                <!-- Contract Info -->
                                <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="بيانات العقد" HorizontalAlignment="Right"/>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="8">

                                            <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultContractNumBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="تاريخ بدء العقد" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultContractDateStartBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="تاريخ انتهاء العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultContractDateEndBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="مبلغ الإيجار" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultRentAmountBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="طريقة الدفع" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultContractPayMethodBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="نوع الوحدة" Grid.Row="5" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultContractApartmentTypeBox" Grid.Row="5" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="الالتزامات"
                                                       Grid.Row="6"
                                                       Grid.Column="1"
                                                       TextAlignment="Right"/>

                                            <TextBlock x:Name="ResultContractOpligationBox"
                                                       Grid.Row="6"
                                                       Grid.Column="0"
                                                       TextAlignment="Right"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                            <TextBlock Text="تفاصيل الوحدة" Grid.Row="7" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultContractUnitDetealsBox" Grid.Row="7" Grid.Column="0" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Unit Info -->
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="بيانات الوحدة" HorizontalAlignment="Right"/>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="8">

                                            <TextBlock Text="اسم الوحدة" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultUnitNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="الحي" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultDistrictBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="المدينة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultCityBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="نوع الوحده" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultUnitTypeBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="رقم الوحدة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultUnitNumBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Owner Info -->
                                <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="بيانات المالك" HorizontalAlignment="Right"/>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="8">

                                            <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultOwnerNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultOwnerIdentityNumberBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultOwnerPhoneBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultOwnerAddressBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Tenant Info -->
                                <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="بيانات المستأجر" HorizontalAlignment="Right"/>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="8">

                                            <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultTenantNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultTenantIdentityNumberBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultTenantPhoneBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                                            <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                                            <TextBlock x:Name="ResultTenantAddressBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>