<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ContractsWindowViewRealEstate"
        x:DataType="models:ContractRealEstate"
        Title="معلومات العقد"
        Width="900"
        Height="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="12" Spacing="12">

            <!-- Edit form -->
            <Border Padding="12" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Click="Print_Click" ToolTip.Tip="طباعة العقد"
                                    Width="36" Height="32" Padding="0" FontSize="16"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">🖨️</Button>

                            <Button Grid.Column="1" Content="📎" Tag="{Binding}" Click="UploadSignature_Click"
                                    Width="36" Height="32" Padding="0" FontSize="16"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="{Binding SignatureButton}" ToolTip.Tip="رفع ملف العقد"/>

                            <Button Grid.Column="2" Content="👁" Tag="{Binding}" Click="OpenSignature_Click"
                                    Width="36" Height="32" Padding="0" FontSize="16"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip.Tip="فتح ملف العقد"/>

                            <Border Grid.Column="3" Background="{Binding StateColor}" Padding="8,2"
                                    MinWidth="60" CornerRadius="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ContractState}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Column="1" Text="عقد الإيجار" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" RowSpacing="8">

                        <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="ContractNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="تاريخ بدء العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <DatePicker x:Name="ContractDateStartPicker" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"/>

                        <TextBlock Text="تاريخ انتهاء العقد" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <DatePicker x:Name="ContractDateEndPicker" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="اسم الوحدة" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="UnitsBox" Grid.Row="5" Grid.Column="0"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:UnitRealEstate">
                                    <TextBlock Text="{Binding UnitName}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="هوية المستأجر" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="5" Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8" RowSpacing="4">

                            <Button Content="بحث" Grid.Row="0" Grid.Column="0" Click="SearchTenant_Click"/>

                            <TextBox x:Name="TenantIdSearchBox" Grid.Row="0" Grid.Column="1"
                                     TextAlignment="Right" Watermark="اكتب رقم الهوية"/>

                            <TextBlock x:Name="TenantInfoText" Grid.Row="1" Grid.ColumnSpan="2"
                                       TextAlignment="Right" TextWrapping="Wrap" Foreground="Green"/>
                        </Grid>

                        <TextBlock Text="مبلغ الإيجار" Grid.Row="6" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="RentAmountBox" Grid.Row="7" Grid.Column="1"
                                 TextAlignment="Right" VerticalAlignment="Top"/>

                        <TextBlock Text="طريقة الدفع" Grid.Row="6" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="ContractPayMethodBox" Grid.Row="7" Grid.Column="0"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="نوع الشقة" Grid.Row="8" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="ContractApartmentTypeBox" Grid.Row="9" Grid.Column="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="الإلتزامات" Grid.Row="8" Grid.Column="0" TextAlignment="Right"/>
                        <ComboBox x:Name="ContractObligationsBox" Grid.Row="9" Grid.Column="0"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="تفاصيل الشقة" Grid.Row="10" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="11" Grid.Column="1"
                              HorizontalAlignment="Right"
                              ColumnDefinitions="Auto,Auto,Auto,Auto">
                            <TextBox x:Name="ContractUnitRoomsNumBox" Grid.Column="2" Width="55" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="3" Text="عدد الغرف" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBox x:Name="ContractUnitFloorNumBox" Grid.Column="0" Width="55" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="عدد الأدوار" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Contract readout -->
            <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="بيانات العقد" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8"
                          FlowDirection="RightToLeft">

                        <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultContractNumBox" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Text="حالة العقد" Grid.Row="0" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock Text="{Binding ContractState}" Grid.Row="0" Grid.Column="3"/>

                        <TextBlock Text="تاريخ البداية" Grid.Row="1" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultContractDateStartBox" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="تاريخ النهاية" Grid.Row="1" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultContractDateEndBox" Grid.Row="1" Grid.Column="3"/>

                        <TextBlock Text="الإيجار" Grid.Row="2" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultRentAmountBox" Grid.Row="2" Grid.Column="1"/>
                        <TextBlock Text="طريقة الدفع" Grid.Row="2" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultContractPayMethodBox" Grid.Row="2" Grid.Column="3"/>

                        <TextBlock Text="نوع الوحدة" Grid.Row="3" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultContractApartmentTypeBox" Grid.Row="3" Grid.Column="1"/>
                        <TextBlock Text="تفاصيل الوحدة" Grid.Row="3" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultContractUnitDetealsBox" Grid.Row="3" Grid.Column="3"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="الالتزامات" FontWeight="Bold" TextAlignment="Right"/>
                        <TextBlock x:Name="ResultContractOpligationBox" TextWrapping="Wrap" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Unit / Owner -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات الوحدة" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="UnitDataGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  FlowDirection="RightToLeft" Height="90"
                                  DoubleTapped="UnitDataGrid_DoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الوحدة" Binding="{ReflectionBinding UnitName}" Width="1.5*"/>
                                <DataGridTextColumn Header="المدينة" Binding="{ReflectionBinding City}" Width="*"/>
                                <DataGridTextColumn Header="الحي" Binding="{ReflectionBinding District}" Width="*"/>
                                <DataGridTextColumn Header="النوع" Binding="{ReflectionBinding UnitType}" Width="*"/>
                                <DataGridTextColumn Header="رقم الوحدة" Binding="{ReflectionBinding UnitNum}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات المالك" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="OwnerDataGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  FlowDirection="RightToLeft" Height="90"
                                  DoubleTapped="OwnerDataGrid_DoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding OwnerName}" Width="1.5*"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding OwnerIdentityNumber}" Width="*"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding OwnerPhone}" Width="*"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding OwnerAddress}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات المستأجر" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="TenantDataGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  FlowDirection="RightToLeft" Height="90"
                                  DoubleTapped="TenantDataGrid_DoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding TenantName}" Width="1.5*"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding TenantIdentityNumber}" Width="*"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding TenantPhone}" Width="*"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding TenantAddress}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Receipts / Expenses -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Border Grid.Column="0" CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="المصروفات" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="ExpensesGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  CanUserSortColumns="True"
                                  FlowDirection="RightToLeft" Height="220"
                                  DoubleTapped="ExpensesGrid_DoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم المصروف" Binding="{ReflectionBinding ExpensesNumber}" Width="1.5*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{ReflectionBinding ExpensesDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                                <DataGridTextColumn Header="الخدمة" Binding="{ReflectionBinding ExpensesService}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{ReflectionBinding ExpensesAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="سندات القبض" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="ReceiptsGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  CanUserSortColumns="True"
                                  FlowDirection="RightToLeft" Height="220"
                                  DoubleTapped="ReceiptsGrid_DoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم السند" Binding="{ReflectionBinding ReceiptNumber}" Width="1.5*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{ReflectionBinding ReceiptDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{ReflectionBinding PaymentMethod}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{ReflectionBinding Amount, StringFormat='{}{0:N2}'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>