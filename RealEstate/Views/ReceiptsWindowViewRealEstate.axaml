<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ReceiptsWindowViewRealEstate"
        x:DataType="models:ReceiptRealEstate"
        Title="معلومات سند القبض"
        Width="800"
        Height="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="6" Spacing="10">

            <Border Padding="12" CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="سند القبض" FontSize="18" TextAlignment="Right"/>

                    <Button Click="Print_Click"
                            ToolTip.Tip="طباعة السند"
                            Width="36"
                            Height="32"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="16">
                        🖨️
                    </Button>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBlock x:Name="ReceiptNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <DatePicker x:Name="ReceiptDate" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="المبلغ" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="AmountBox"
                                 Grid.Row="3"
                                 Grid.Column="0"
                                 TextAlignment="Right"
                                 MaxHeight="32"
                                 VerticalAlignment="Top"/>

                        <TextBlock Text="رقم العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="3"
                              Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              RowSpacing="4">

                            <Button Content="بحث"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Click="SearchContract_Click"/>

                            <TextBox x:Name="ContractNumSearchBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     HorizontalAlignment="Stretch"
                                     TextAlignment="Right"
                                     Watermark="اكتب رقم العقد"/>

                            <TextBlock x:Name="ContractInfoText"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       TextAlignment="Right"
                                       Foreground="Green"/>
                        </Grid>

                        <TextBlock Text="طريقة الدفع" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="PaymentMethodBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Receipt data organized -->
            <Border CornerRadius="12" Padding="12">
                <StackPanel Spacing="10">

                    <TextBlock Text="بيانات سند القبض"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          FlowDirection="RightToLeft">

                        <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="رقم السند" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultReceiptNumBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="تاريخ السند" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultReceiptDateBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="مبلغ السند" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultAmountBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="طريقة الدفع" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="ResultPaymentMethodBox" TextAlignment="Right"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

            <!-- Related data grids -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">

                <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات العقد" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="ContractDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  Height="130"
                                  DoubleTapped="ContractDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم العقد" Binding="{ReflectionBinding ContractNumber}" Width="120"/>
                                <DataGridTextColumn Header="البداية" Binding="{ReflectionBinding ContractStartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="120"/>
                                <DataGridTextColumn Header="النهاية" Binding="{ReflectionBinding ContractEndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="120"/>
                                <DataGridTextColumn Header="الإيجار" Binding="{ReflectionBinding RentAmount}" Width="100"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات الوحدة" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="UnitDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  Height="130"
                                  DoubleTapped="UnitDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الوحدة" Binding="{ReflectionBinding UnitName}" Width="140"/>
                                <DataGridTextColumn Header="الحي" Binding="{ReflectionBinding District}" Width="110"/>
                                <DataGridTextColumn Header="المدينة" Binding="{ReflectionBinding City}" Width="110"/>
                                <DataGridTextColumn Header="النوع" Binding="{ReflectionBinding UnitType}" Width="100"/>
                                <DataGridTextColumn Header="رقم الوحدة" Binding="{ReflectionBinding UnitNum}" Width="90"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات المالك" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="OwnerDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  Height="130"
                                  DoubleTapped="OwnerDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding OwnerName}" Width="140"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding OwnerIdentityNumber}" Width="130"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding OwnerPhone}" Width="120"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding OwnerAddress}" Width="160"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات المستأجر" FontSize="16" HorizontalAlignment="Right"/>

                        <DataGrid x:Name="TenantDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  FlowDirection="RightToLeft"
                                  Height="130"
                                  DoubleTapped="TenantDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding TenantName}" Width="140"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding TenantIdentityNumber}" Width="130"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding TenantPhone}" Width="120"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding TenantAddress}" Width="160"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>