<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ReceiptsWindowViewRealEstate"
        x:DataType="models:ReceiptRealEstate"
        Title="معلومات سند القبض"
        Width="800"
        Height="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="12" Spacing="12">

            <Border Padding="12" CornerRadius="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0"
                                Click="Print_Click"
                                ToolTip.Tip="طباعة السند"
                                Width="36"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="16">
                            🖨️
                        </Button>
                        <TextBlock Grid.Column="1" Text="سند القبض" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBlock x:Name="ReceiptNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                        <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <DatePicker x:Name="ReceiptDate" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="المبلغ" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                        <TextBox x:Name="AmountBox"
                                 Grid.Row="3"
                                 Grid.Column="0"
                                 TextAlignment="Right"
                                 MaxHeight="32"
                                 VerticalAlignment="Top"/>

                        <TextBlock Text="رقم العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>

                        <Grid Grid.Row="3"
                              Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              RowSpacing="4">

                            <Button Content="بحث"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Click="SearchContract_Click"/>

                            <TextBox x:Name="ContractNumSearchBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     HorizontalAlignment="Stretch"
                                     TextAlignment="Right"
                                     Watermark="اكتب رقم العقد"/>

                            <TextBlock x:Name="ContractInfoText"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Foreground="Green"/>
                        </Grid>

                        <TextBlock Text="طريقة الدفع" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="PaymentMethodBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Right">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Receipt readout -->
            <Border CornerRadius="12" Padding="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="10">

                    <TextBlock Text="بيانات سند القبض"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="8"
                          FlowDirection="RightToLeft">

                        <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultReceiptNumBox" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultReceiptDateBox" Grid.Row="0" Grid.Column="3"/>

                        <TextBlock Text="مبلغ السند" Grid.Row="1" Grid.Column="0" Foreground="Gray"/>
                        <TextBlock x:Name="ResultAmountBox" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="طريقة الدفع" Grid.Row="1" Grid.Column="2" Foreground="Gray"/>
                        <TextBlock x:Name="ResultPaymentMethodBox" Grid.Row="1" Grid.Column="3"/>

                    </Grid>
                </StackPanel>
            </Border>

            <!-- Related data grids -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات العقد" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="ContractDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FlowDirection="RightToLeft"
                                  Height="100"
                                  DoubleTapped="ContractDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم العقد" Binding="{ReflectionBinding ContractNumber}" Width="1.5*"/>
                                <DataGridTextColumn Header="البداية" Binding="{ReflectionBinding ContractStartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                                <DataGridTextColumn Header="النهاية" Binding="{ReflectionBinding ContractEndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                                <DataGridTextColumn Header="الإيجار" Binding="{ReflectionBinding RentAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات الوحدة" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="UnitDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FlowDirection="RightToLeft"
                                  Height="100"
                                  DoubleTapped="UnitDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الوحدة" Binding="{ReflectionBinding UnitName}" Width="1.5*"/>
                                <DataGridTextColumn Header="الحي" Binding="{ReflectionBinding District}" Width="*"/>
                                <DataGridTextColumn Header="المدينة" Binding="{ReflectionBinding City}" Width="*"/>
                                <DataGridTextColumn Header="النوع" Binding="{ReflectionBinding UnitType}" Width="*"/>
                                <DataGridTextColumn Header="رقم الوحدة" Binding="{ReflectionBinding UnitNum}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات المالك" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="OwnerDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FlowDirection="RightToLeft"
                                  Height="100"
                                  DoubleTapped="OwnerDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding OwnerName}" Width="1.5*"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding OwnerIdentityNumber}" Width="*"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding OwnerPhone}" Width="*"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding OwnerAddress}" Width="1.5*"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="انقر مرتين للفتح" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="بيانات المستأجر" FontSize="16" TextAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="TenantDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FlowDirection="RightToLeft"
                                  Height="100"
                                  DoubleTapped="TenantDataGrid_DoubleTapped">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{ReflectionBinding TenantName}" Width="1.5*"/>
                                <DataGridTextColumn Header="رقم الهوية" Binding="{ReflectionBinding TenantIdentityNumber}" Width="*"/>
                                <DataGridTextColumn Header="الجوال" Binding="{ReflectionBinding TenantPhone}" Width="*"/>
                                <DataGridTextColumn Header="العنوان" Binding="{ReflectionBinding TenantAddress}" Width="1.5*"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>