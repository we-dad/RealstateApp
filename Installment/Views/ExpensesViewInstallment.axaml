<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.ExpensesViewInstallment"
             x:DataType="models:ExpensesInstallment">

    <Grid RowDefinitions="Auto,Auto,*" Margin="6" RowSpacing="10">

        <Border Grid.Row="0" Padding="12" CornerRadius="12"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="المصروفات" FontSize="18" TextAlignment="Right"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <TextBlock Text="رقم سند الصرف" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ExpensesNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                    <TextBlock x:Name="ExpensesDateBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                    <TextBlock Text="اسم المنتج" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <ComboBox x:Name="ProductBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductInstallment">
                                <TextBlock Text="{Binding ProductName}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="نوع الخدمة" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                    <ComboBox x:Name="ExpensesServiceBox"
                              Grid.Row="3"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="مبلغ الصرف" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <TextBox x:Name="ExpensesAmountBox" Grid.Row="5" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="الملاحظات" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                    <TextBox x:Name="ExpensesNoteBox" Grid.Row="5" Grid.Column="0" TextAlignment="Right"/>

                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="تحديث" Click="Refresh_Click"/>
                    <Button Content="إضافة" Click="Add_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- List heading + hint -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="انقر مرتين على السند لفتح التفاصيل"
                       FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="قائمة المصروفات" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2"
                CornerRadius="12"
                Padding="4"
                BorderBrush="#DDD" BorderThickness="1">

            <DataGrid x:Name="ExpensesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      x:DataType="models:ExpensesInstallment"
                      FlowDirection="RightToLeft"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="رقم سند الصرف" Binding="{Binding ExpensesNumber}" Width="*"/>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="1.5*"/>
                    <DataGridTextColumn Header="تاريخ السند" Binding="{Binding ExpensesDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                    <DataGridTextColumn Header="نوع الخدمة" Binding="{Binding ExpensesService}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding ExpensesAmount, StringFormat='{}{0:N2}'}" Width="*"/>

                    <DataGridTemplateColumn Header="طباعة" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="Print_Click"
                                        Tag="{Binding}"
                                        ToolTip.Tip="طباعة سند الصرف"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        FontSize="16">🖨️</Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>