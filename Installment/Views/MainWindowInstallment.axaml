<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealEstateInstallmentsManager.MainWindowInstallment">

    <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="12">

        <Border Grid.Row="0" Classes="navBar">
            <StackPanel Spacing="10">

                <TextBlock Text="إدارة التقسيط"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Center"
                            FlowDirection="RightToLeft">

                    <Button Classes="navHome"
                            Click="Nav_Home"
                            ToolTip.Tip="صفحة البدء">
                        🏠
                    </Button>
                    <Button x:Name="TabDashboard" Classes="navBtn" Content="الإحصائيات" Click="Nav_Dashboard"/>
                    <Button x:Name="TabOwners" Classes="navBtn" Content="الملاك" Click="Nav_Owners"/>
                    <Button x:Name="TabCustomer" Classes="navBtn" Content="العملاء" Click="Nav_Customer"/>
                    <Button x:Name="TabProducts" Classes="navBtn" Content="المنتجات" Click="Nav_Products"/>
                    <Button x:Name="TabContracts" Classes="navBtn" Content="عقد البيع" Click="Nav_Contracts"/>
                    <Button x:Name="TabReceipts" Classes="navBtn" Content="سند قبض" Click="Nav_Receipts"/>
                    <Button x:Name="TabExpenses" Classes="navBtn" Content="المصروفات" Click="Nav_Expenses"/>

                </StackPanel>

                <TextBlock x:Name="SyncStatusText"
                           HorizontalAlignment="Center"
                           FlowDirection="RightToLeft"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#B9C4C2"/>

            </StackPanel>
        </Border>


        <!-- Content -->
        <Border Grid.Row="1" Classes="card">
            <ContentControl x:Name="ContentHost"/>
        </Border>

    </Grid>
</UserControl>
