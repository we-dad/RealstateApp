<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ReceiptWindowViewInstallment"
        x:DataType="models:ReceiptInstallment"
        Title="معلومات سند القبض"
        Width="700"
        Height="750">

    <Grid RowDefinitions="Auto,*" Margin="6">

        <Border Grid.Row="0" Padding="12" CornerRadius="12"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="سند القبض" FontSize="18" TextAlignment="Right"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ReceiptNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                    <DatePicker x:Name="ReceiptDate" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                    <TextBlock Text="المبلغ"
                               Grid.Row="2"
                               Grid.Column="0"
                               TextAlignment="Right"/>

                    <TextBox x:Name="AmountBox"
                             Grid.Row="3"
                             Grid.Column="0"
                             TextAlignment="Right"
                             MaxHeight="32"
                             VerticalAlignment="Top"/>

                    <TextBlock Text="رقم العقد"
                               Grid.Row="2"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <Grid Grid.Row="3"
                          Grid.Column="1"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowSpacing="4">

                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    FlowDirection="RightToLeft">

                            <TextBox x:Name="ContractNumSearchBox"
                                     Width="160"
                                     TextAlignment="Right"
                                     Watermark="اكتب رقم العقد"/>

                            <TextBlock Text="Ic-"
                                       VerticalAlignment="Center"/>

                            <Button Content="بحث"
                                    Click="SearchContract_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="طريقة الدفع" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <ComboBox x:Name="PaymentMethodBox"
                              Grid.Row="5"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="ContractInfoText"
                               Grid.Row="5"
                               Grid.Column="0"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               FontSize="16"/>

                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="حذف البيانات" Click="Delete_Click"/>
                    <Button Content="تحديث البيانات" Click="Update_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
        
<ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Margin="0,10,0,0">

    <StackPanel Spacing="10">

        <!-- Receipt Info (readout) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات سند القبض" HorizontalAlignment="Right"/>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">

                    <TextBlock Text="رقم السند" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultReceiptNumBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ السند" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultReceiptDateBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="مبلغ السند" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultAmountBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="طريقة الدفع" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultPaymentMethodBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="المتبقي" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultCurrentTotalAmountBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Contract (double-tap opens contract) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح العقد"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات العقد" TextAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="ContractGrid"
                          x:DataType="models:ContractInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="1.5*"/>
                        <DataGridTextColumn Header="الاجمالي" Binding="{Binding MainTotalAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding CurrentTotalAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="القسط الشهري" Binding="{Binding MonthlyInstallment, StringFormat='{}{0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding ContractState}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Product (double-tap opens product) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح السلعة"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات المنتج" TextAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="ProductGrid"
                          x:DataType="models:ProductInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="1.5*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ProductType}" Width="*"/>
                        <DataGridTextColumn Header="السعر الأساسي" Binding="{Binding ProductMainPrice, StringFormat='{}{0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Customer (double-tap opens customer) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح العميل"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات العميل" TextAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="CustomerGrid"
                          x:DataType="models:CustomerInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="*"/>
                        <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="الكفيل" Binding="{Binding SponserName}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Owner (double-tap opens owner) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح المالك"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات المالك" TextAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="OwnerGrid"
                          x:DataType="models:OwnerInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="*"/>
                        <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

    </StackPanel>
</ScrollViewer>

    </Grid>
</Window>
