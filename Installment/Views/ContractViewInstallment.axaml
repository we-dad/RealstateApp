<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.ContractViewInstallment"
             x:DataType="models:ContractInstallment">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="12" Spacing="12">

            <Border Padding="12" CornerRadius="12"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="عقد البيع" FontSize="18" TextAlignment="Right"/>

                    <!-- Entry mode: auto / manual (left side) -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                        <RadioButton x:Name="AutoModeRadio" Content="تلقائي" IsChecked="True"
                                     IsCheckedChanged="Mode_Changed"/>
                        <RadioButton x:Name="ManualModeRadio" Content="يدوي"
                                     IsCheckedChanged="Mode_Changed"/>
                        <TextBlock Text=": طريقة الإدخال" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                        <TextBox x:Name="ContractNumBox" Grid.Row="1" Grid.Column="1"
                                 TextAlignment="Right" IsReadOnly="True"/>

                        <TextBlock Text="تاريخ العقد" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                        <DatePicker x:Name="ContractDateStartPicker" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                        <TextBlock Text="اسم المنتج" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                        <ComboBox x:Name="ProductsBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ProductsBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductInstallment">
                                    <TextBlock Text="{Binding ProductName}" TextAlignment="Right"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="هوية العميل"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   TextAlignment="Right"/>

                        <Grid Grid.Row="3"
                              Grid.Column="0"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              RowSpacing="4">

                            <Button Content="بحث"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Click="SearchCustomer_Click"/>

                            <TextBox x:Name="CustomerIdSearchBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     HorizontalAlignment="Stretch"
                                     TextAlignment="Right"
                                     Watermark="اكتب رقم الهوية"/>

                            <SelectableTextBlock x:Name="CustomerInfoText"
                                                 Grid.Row="1"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 TextAlignment="Right"
                                                 TextWrapping="Wrap"
                                                 Foreground="Green"/>
                        </Grid>

                        <TextBlock Text="نسبة الفائدة السنوية"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                   TextAlignment="Right"
                                   FlowDirection="RightToLeft"/>

                        <StackPanel Grid.Row="5" Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        FlowDirection="RightToLeft">

                                <ComboBox x:Name="InterestPercentBox"
                                          HorizontalAlignment="Stretch"
                                          FlowDirection="RightToLeft"
                                          SelectionChanged="InterestPercentBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="%"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="CustomInterestBox"
                                         Width="100"
                                         Watermark="النسبة"
                                         TextAlignment="Right"
                                         IsVisible="False"
                                         TextChanged="CustomInterestBox_TextChanged"/>
                            </StackPanel>

                            <TextBlock x:Name="CustomInterestErrorText"
                                       Foreground="Red"
                                       FontSize="12"
                                       TextAlignment="Right"/>
                        </StackPanel>

                        <TextBlock Text="رسوم ادارية"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   TextAlignment="Right"/>

                        <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        FlowDirection="RightToLeft">
                                <TextBox x:Name="ManagementFeeBox"
                                         Width="150"
                                         TextAlignment="Right"
                                         TextChanged="ManagementFeeBox_TextChanged"/>
                                <TextBlock Text="ريال"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="ManagementFeeErrorText"
                                       Foreground="Red"
                                       FontSize="12"
                                       TextAlignment="Right"/>
                        </StackPanel>

                        <TextBlock Text="مدة العقد"
                                   Grid.Row="6"
                                   Grid.Column="1"
                                   TextAlignment="Right"/>

                        <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        FlowDirection="RightToLeft">
                                <TextBox x:Name="ContractPeriodBox"
                                         Width="150"
                                         TextAlignment="Right"
                                         TextChanged="ContractPeriodBox_TextChanged"/>
                                <TextBlock Text="شهر"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ContractPeriodErrorText"
                                       Foreground="Red"
                                       FontSize="12"
                                       TextAlignment="Right"/>
                        </StackPanel>

                        <TextBlock Text="اجمالي قيمة المنتج"
                                   Grid.Row="6"
                                   Grid.Column="0"
                                   TextAlignment="Right"/>

                        <StackPanel Grid.Row="7" Grid.Column="0" Spacing="4">
                            <TextBox x:Name="MainTotalAmountBox"
                                     TextAlignment="Right"
                                     VerticalAlignment="Top"
                                     Text="{Binding MainTotalAmount}"
                                     IsReadOnly="True"
                                     TextChanged="MainTotalAmountBox_TextChanged"/>
                        </StackPanel>

                        <TextBlock Text="القسط الشهري"
                                   Grid.Row="8"
                                   Grid.Column="1"
                                   TextAlignment="Right"/>

                        <StackPanel Grid.Row="9" Grid.Column="1" Spacing="4">
                            <SelectableTextBlock x:Name="MonthlyInstallmentBox"
                                                 FontSize="32"
                                                 FontWeight="Bold"
                                                 TextAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Stretch"
                                    FlowDirection="RightToLeft"
                                    Grid.Row="9"
                                    Grid.Column="0">

                            <CheckBox Content="بدفعة مقدمة"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding BoolDownPayment, Mode=TwoWay}" />

                            <StackPanel Spacing="4">
                                <TextBox x:Name="DownPaymentBox"
                                         Width="150"
                                         Watermark="ادخل الرقم"
                                         TextAlignment="Right"
                                         IsVisible="{Binding BoolDownPayment}"
                                         TextChanged="DownPaymentBox_TextChanged"/>

                                <TextBlock x:Name="DownPaymentErrorText"
                                           Foreground="Red"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           IsVisible="{Binding BoolDownPayment}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="تحديث" Click="Refresh_Click"/>
                        <Button Content="إضافة" Click="Add_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Table -->
            <Border CornerRadius="12"
                    Padding="12"
                    BorderBrush="#DDD" BorderThickness="1">

                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="انقر مرتين على العقد لفتح التفاصيل"
                                   FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="قائمة العقود"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- SelectionMode + ClipboardCopyMode give whole-row Ctrl+C copy, no code-behind.
                         The SelectableTextBlock cells give per-cell select + copy (right-click / Ctrl+C). -->
                    <DataGrid x:Name="ContractGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              x:DataType="models:ContractInstallment"
                              FlowDirection="RightToLeft"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              SelectionMode="Extended"
                              ClipboardCopyMode="IncludeHeader"
                              Height="430">

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="#" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <SelectableTextBlock Text="{Binding Id}"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="رقم العقد" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <SelectableTextBlock Text="{Binding ContractNumber}"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="اسم العميل" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <SelectableTextBlock Text="{Binding CustomerName}"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="تاريخ بدء العقد" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <SelectableTextBlock Text="{Binding ContractStartDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="تاريخ انتهاء العقد" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <SelectableTextBlock Text="{Binding ContractEndDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="حالة العقد" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <Border Background="{Binding StateColor}"
                                                Padding="6,2"
                                                MinWidth="50"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <SelectableTextBlock Text="{Binding ContractState}"
                                                                 Foreground="White"
                                                                 SelectionBrush="#553399FF"
                                                                 TextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="طباعة العقد" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="Print_Click"
                                                Tag="{Binding}"
                                                ToolTip.Tip="طباعة العقد"
                                                Width="36" Height="32" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontSize="16">🖨️</Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="طباعة سند لأمر" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="PrintSanadAmr_Click"
                                                Tag="{Binding}"
                                                ToolTip.Tip="طباعة سند لأمر"
                                                Width="36" Height="32" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontSize="16">🖨️</Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ملف العقد" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <Button Content="📎"
                                                Tag="{Binding}"
                                                Click="UploadSignature_Click"
                                                Width="40" Height="32"
                                                Background="{Binding SignatureButton}"
                                                ToolTip.Tip="رفع ملف العقد"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="فتح الملف" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContractInstallment">
                                        <Button Content="👁"
                                                Tag="{Binding}"
                                                Click="OpenSignature_Click"
                                                Width="40" Height="32"
                                                ToolTip.Tip="فتح ملف العقد"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
