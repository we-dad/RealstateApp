<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        x:Class="RealEstateInstallmentsManager.Views.ExpensesWindowViewInstallment"
        x:DataType="models:ExpensesInstallment"
        Title="معلومات سند الصرف"
        Width="700"
        Height="550">

    <Grid RowDefinitions="Auto,*" Margin="6">

        <Border Grid.Row="0" Padding="12" CornerRadius="12"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="المصروفات" FontSize="18" TextAlignment="Right"/>

                <Button Click="Print_Click"
                        Tag="{Binding}"
                        ToolTip.Tip="طباعة سند الصرف"
                        Width="36"
                        Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="16">
                    🖨️
                </Button>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <TextBlock Text="رقم سند الصرف" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ExpensesNumBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ السند" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                    <DatePicker x:Name="ExpensesDateBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                    <TextBlock Text="اسم الوحدة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <ComboBox x:Name="ProductBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductInstallment">
                                <TextBlock Text="{Binding ProductName}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="نوع الخدمة" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
                    <ComboBox x:Name="ExpensesServiceBox"
                              Grid.Row="3"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="مبلغ الصرف" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <TextBox x:Name="ExpensesAmountBox" Grid.Row="5" Grid.Column="1" TextAlignment="Right"/>

                    <TextBlock Text="الملاحظات" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                    <TextBox x:Name="ExpensesNoteBox" Grid.Row="5" Grid.Column="0" TextAlignment="Right"/>

                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="حذف البيانات" Click="Delete_Click"/>
                    <Button Content="تحديث البيانات" Click="Update_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

       <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Margin="0,10,0,0">

    <StackPanel Spacing="10">

        <!-- Expenses Info (readout) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات الصرف" HorizontalAlignment="Right"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">

                    <TextBlock Text="رقم سند الصرف" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultExpensesNumBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ السند" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultExpensesDateBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="نوع الخدمة" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultExpensesServiceBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="مبلغ الصرف" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultExpensesAmountBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="الملاحظات" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultExpensesNoteBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Product (double-tap opens product) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح السلعة"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات المنتج" TextAlignment="Right"/>
                </Grid>
                <DataGrid x:Name="ProductGrid"
                          x:DataType="models:ProductInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="1.5*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ProductType}" Width="*"/>
                        <DataGridTextColumn Header="السعر الأساسي" Binding="{Binding ProductMainPrice, StringFormat='{}{0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

    </StackPanel>
</ScrollViewer>

    </Grid>
</Window>
