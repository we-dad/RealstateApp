<Window x:Class="RealEstateInstallmentsManager.Views.CustomerWindowViewInstallment"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:RealEstateInstallmentsManager.Models"
        x:DataType="models:CustomerInstallment"
        Title="معلومات العميل"
        Width="700"
        Height="700">

    <Grid RowDefinitions="Auto,*" Margin="16">

        <Border Grid.ColumnSpan="2" Padding="12" CornerRadius="12"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="العميل" FontSize="18" HorizontalAlignment="Right"/>

                <Button Content="طباعة السجل المالي"
                        Click="PrintFinancialRecord_Click"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="10" RowSpacing="8">

          <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
          <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

          <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
          <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>

          <TextBlock Text="رقم الجوال" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>
          <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

          <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
          <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>

          <TextBlock Text="الوظيفة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
          <TextBox x:Name="JobBox" Grid.Row="5" Grid.Column="1" TextAlignment="Right"/>


          <CheckBox Grid.Row="5"
                    Grid.Column="0"
                    Content="يوجد كفيل"
                    x:Name="BoolSponserBox"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    IsChecked="{Binding BoolSponser, Mode=TwoWay}" />

          <TextBlock Text="اسم الكفيل" Grid.Row="6" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserNameBox" Grid.Row="7" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="رقم هوية الكفيل" Grid.Row="6" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserIdentityNumberBox" Grid.Row="7" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="رقم جوال الكفيل" Grid.Row="8" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserPhoneBox" Grid.Row="9" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="عنوان الكفيل" Grid.Row="8" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserAddressBox" Grid.Row="9" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="وظيفة الكفيل" Grid.Row="10" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserJobBox" Grid.Row="11" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>


          <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="حذف البيانات" Click="Delete_Click"/>
              <Button Content="تحديث البيانات" Click="Update_Click"/>
          </StackPanel>

        </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,0">

            <StackPanel Spacing="10">

                <Border CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="بيانات العميل" HorizontalAlignment="Right"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="8">

                            <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                            <TextBlock x:Name="ResultNameBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                            <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                            <TextBlock x:Name="ResultIdentityNumberBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                            <TextBlock Text="رقم الجوال" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                            <TextBlock x:Name="ResultPhoneBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                            <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                            <TextBlock x:Name="ResultAddressBox" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                            <TextBlock Text="الوظيفة" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                            <TextBlock x:Name="ResultJobBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>

                            <TextBlock Text="اسم الكفيل" Grid.Row="5" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
                            <TextBlock x:Name="ResultSponserNameBox" Grid.Row="5" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

                            <TextBlock Text="رقم هوية الكفيل" Grid.Row="6" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
                            <TextBlock x:Name="ResultSponserIdentityNumberBox" Grid.Row="6" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

                            <TextBlock Text="رقم جوال الكفيل" Grid.Row="7" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
                            <TextBlock x:Name="ResultSponserPhoneBox" Grid.Row="7" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

                            <TextBlock Text="عنوان الكفيل" Grid.Row="8" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
                            <TextBlock x:Name="ResultSponserAddressBox" Grid.Row="8" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

                            <TextBlock Text="وظيفة الكفيل" Grid.Row="9" Grid.Column="1" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>
                            <TextBlock x:Name="ResultSponserJobBox" Grid.Row="9" Grid.Column="0" TextAlignment="Right" IsVisible="{Binding BoolSponser}"/>

                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="10">

                        <TextBlock Text="الملخص المالي"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

                            <Border Grid.Column="3" CornerRadius="10" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="إجمالي العقود" TextAlignment="Center"/>
                                    <TextBlock x:Name="TotalAmountText" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="10" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="المدفوع" TextAlignment="Center"/>
                                    <TextBlock x:Name="PaidAmountText" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="10" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="المتبقي" TextAlignment="Center"/>
                                    <TextBlock x:Name="LeftAmountText" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="0" CornerRadius="10" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="عدد السندات" TextAlignment="Center"/>
                                    <TextBlock x:Name="ReceiptsCountText" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Padding="12"
                        BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel Spacing="8">

                        <TextBlock Text="حالة السداد"
                                   FontSize="18"
                                   HorizontalAlignment="Right"/>

                        <ProgressBar x:Name="PaymentProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="18"/>

                        <TextBlock x:Name="PaymentProgressText"
                                   TextAlignment="Center"/>

                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                    <!-- Contracts -->
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Padding="12"
                            BorderBrush="#DDD" BorderThickness="1">

                        <StackPanel Spacing="8">

                            <TextBlock Text="العقود"
                                       FontSize="18"
                                       HorizontalAlignment="Right"/>

                            <DataGrid x:Name="CustomerContractsGrid"
                                      x:DataType="models:CustomerInstallment"
                                      FlowDirection="RightToLeft"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      Height="250">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="*"/>
                                    <DataGridTextColumn Header="البداية" Binding="{Binding ContractStartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="النهاية" Binding="{Binding ContractEndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding ContractState}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>

                    </Border>

                    <!-- Receipts -->
                    <Border Grid.Column="0"
                            CornerRadius="12"
                            Padding="12"
                            BorderBrush="#DDD" BorderThickness="1">

                        <StackPanel Spacing="8">

                            <TextBlock Text="سندات القبض"
                                       FontSize="18"
                                       HorizontalAlignment="Right"/>

                            <DataGrid x:Name="CustomerReceiptsGrid"
                                      x:DataType="models:CustomerInstallment"
                                      FlowDirection="RightToLeft"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      Height="250">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم السند" Binding="{Binding ReceiptNumber}" Width="*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ReceiptDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding ReceiptAmount, StringFormat='{}{0:N2}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>