<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.CustomerViewInstallment"
             x:DataType="models:CustomerInstallment"
             FlowDirection="RightToLeft">

  <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="12">

    <!-- Form -->
    <Border Grid.Row="0" Padding="12" CornerRadius="12"
            BorderBrush="#DDD" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="العملاء" FontSize="18"/>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="10" RowSpacing="8">

          <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0"/>
          <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0"/>

          <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="1"/>
          <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="1"/>

          <TextBlock Text="رقم الجوال" Grid.Row="2" Grid.Column="0"/>
          <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="0"/>

          <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="1"/>
          <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="1"/>

          <TextBlock Text="الوظيفة" Grid.Row="4" Grid.Column="1"/>
          <TextBox x:Name="JobBox" Grid.Row="5" Grid.Column="1"/>

          <CheckBox Grid.Row="5"
                    Grid.Column="0"
                    Content="يوجد كفيل"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    IsChecked="{Binding BoolSponser, Mode=TwoWay}" />

          <TextBlock Text="اسم الكفيل" Grid.Row="6" Grid.Column="0" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserNameBox" Grid.Row="7" Grid.Column="0" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="رقم هوية الكفيل" Grid.Row="6" Grid.Column="1" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserIdentityNumberBox" Grid.Row="7" Grid.Column="1" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="رقم جوال الكفيل" Grid.Row="8" Grid.Column="0" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserPhoneBox" Grid.Row="9" Grid.Column="0" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="عنوان الكفيل" Grid.Row="8" Grid.Column="1" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserAddressBox" Grid.Row="9" Grid.Column="1" IsVisible="{Binding BoolSponser}"/>

          <TextBlock Text="وظيفة الكفيل" Grid.Row="10" Grid.Column="1" IsVisible="{Binding BoolSponser}"/>
          <TextBox x:Name="SponserJobBox" Grid.Row="11" Grid.Column="1" IsVisible="{Binding BoolSponser}"/>

          <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Content="إضافة" Click="Add_Click"/>
            <Button Content="تحديث" Click="Refresh_Click"/>
          </StackPanel>

        </Grid>
      </StackPanel>
    </Border>

    <!-- List heading + hint -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="قائمة العملاء" FontSize="14" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="انقر مرتين على العميل لفتح التفاصيل"
                 FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
    </Grid>

    <!-- Table -->
    <Border Grid.Row="2" CornerRadius="12" Padding="4"
            BorderBrush="#DDD" BorderThickness="1">
      <DataGrid x:Name="CustomerGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                x:DataType="models:CustomerInstallment"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
          <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="180"/>
          <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="160"/>
          <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </Grid>
</UserControl>