<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.OwnersViewInstallment"
             x:DataType="models:OwnerInstallment"
             FlowDirection="RightToLeft">

  <!-- Restyled on the new identity per the client's reference mockup (owners.html/
       owner-new.html), keeping only what our actual data supports: the mockup's
       owner is a full investor (profit share %, capital, IBAN, profit
       distribution schedule...) - none of that exists in OwnerInstallment or the
       database, and the developer was explicit: match the look, add no new
       fields. So this stays the same 4 fields (Name/IdentityNumber/Phone/
       Address) - only the visual language (cards, buttons, colors) changed.

       Per the developer's explicit follow-up request, this is now a standalone
       list page: no inline add-form (unlike every other XView in the app) -
       "مالك جديد" opens a separate add window (OwnersAddWindowViewInstallment),
       matching the mockup's own separate owners.html/owner-new.html pages. -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="14" Background="{DynamicResource BrushBg}">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*">
      <TextBlock Grid.Column="3" Text="الملاك" FontSize="21" FontWeight="Bold"
                 Foreground="{DynamicResource BrushInk}"/>
      <TextBlock Grid.Column="2" x:Name="OwnersCountText" FontSize="13"
                 Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Bottom" Margin="0,0,10,0"/>
      <Button Grid.Column="1" Classes="outline" Content="تحديث" Click="Refresh_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="0" Classes="add" Content="مالك جديد" Click="AddOwner_Click"/>
    </Grid>

    <!-- List heading -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <TextBlock Grid.Column="1" Text="قائمة الملاك" FontSize="14" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="0" Text="انقر مرتين على المالك لفتح التفاصيل"
                 FontSize="12" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
    </Grid>

    <!-- Table -->
    <Border Grid.Row="2" Classes="card" Padding="8">
      <DockPanel>
        <TextBox x:Name="OwnersGridSearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" TextAlignment="Right"
                 Watermark="ابحث في الجدول: اسم، رقم، تاريخ، أي كلمة..."/>
        <DataGrid x:Name="OwnersGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  x:DataType="models:OwnerInstallment"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="180"/>
            <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="160"/>
            <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
