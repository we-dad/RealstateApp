<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.OwnersViewInstallment"
             x:DataType="models:OwnerInstallment"
             FlowDirection="RightToLeft">

  <!-- Restyled to match the developer's own updated mockup (owners.html, v3) as
       closely as our real data allows:
       - Only the 4 real fields (Name/IdentityNumber/Phone/Address) - the
         mockup's "العقود النشطة"/"رأس المال في العقود"/"الربح المحقق" columns
         were tried once and explicitly rejected: no new columns, computed or
         not - back to the plain table.
       - DataGrid header/row colors and borders are styled here (BrushSoft
         header background, 1px BrushLine under the header row, BrushLine2 row
         separators - matching the mockup's .t table CSS pixel-for-pixel: th
         padding 9px/10px, font-size 12px/600 weight, td padding 9px/10px,
         font-size 14px) since Avalonia's default DataGrid theme doesn't
         resemble it at all otherwise - scoped to this screen only, not
         Theme.axaml globally, until the developer approves it for wider use.
       - No Background on the root Grid: this view is hosted inside
         MainWindowInstallment's own white "card" Border around ContentHost,
         so painting a second (different) background here just showed as a
         mismatched rectangle inside that white frame - removed. -->
  <UserControl.Styles>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource BrushSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="10">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="الملاك" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
        <TextBlock x:Name="OwnersCountText" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
      </StackPanel>
      <TextBox Grid.Column="2" x:Name="OwnersGridSearchBox" Width="260" TextAlignment="Right"
                Watermark="الاسم، الجوال، رقم الهوية">
        <TextBox.InnerLeftContent>
          <Viewbox Width="16" Height="16" Margin="9,0,0,0" FlowDirection="LeftToRight">
            <Canvas Width="24" Height="24">
              <Path Data="{DynamicResource Icon.Search}" Stroke="{DynamicResource BrushMuted}"
                    StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
            </Canvas>
          </Viewbox>
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="3" Classes="outline" Content="تحديث" Click="Refresh_Click" Margin="8,0,8,0"/>
      <Button Grid.Column="4" Classes="add" Click="AddOwner_Click">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Viewbox Width="16" Height="16" FlowDirection="LeftToRight">
            <Canvas Width="24" Height="24">
              <Path Data="{DynamicResource Icon.Plus}" Stroke="{DynamicResource BrushInk}"
                    StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
            </Canvas>
          </Viewbox>
          <TextBlock Text="مالك جديد"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Table -->
    <Border Grid.Row="1" Classes="card" Padding="0">
      <DataGrid x:Name="OwnersGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                x:DataType="models:OwnerInstallment"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{DynamicResource BrushLine2}"
                HeadersVisibility="Column"
                RowBackground="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <DataGrid.Columns>
          <DataGridTextColumn Header="رقم المالك" Binding="{Binding Id, StringFormat='O-{0}'}" Width="90"/>
          <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.4*"/>
          <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="150"/>
          <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="160"/>
          <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"/>
          <DataGridTemplateColumn Header="" Width="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="models:OwnerInstallment">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4">
                  <Button Classes="outline" Content="العقود" Padding="10,4" FontSize="12"
                          Click="OpenContracts_Click"/>
                  <Button Classes="outline" Content="تعديل" Padding="10,4" FontSize="12"
                          Click="EditOwner_Click"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Footer hint (the real count now lives in the header, next to "الملاك") -->
    <TextBlock Grid.Row="2" Text="اضغط مرتين على الصف لتعديل بيانات المالك"
               FontSize="12" Foreground="{DynamicResource BrushMuted}"/>

  </Grid>
</UserControl>
