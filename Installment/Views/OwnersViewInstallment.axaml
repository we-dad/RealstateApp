<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.OwnersViewInstallment"
             x:DataType="models:OwnerInstallment"
             FlowDirection="RightToLeft">

  <!-- Restyled to match the developer's own updated mockup (owners.html, v3) as
       closely as our real data allows:
       - No text heading at all (the developer asked to drop it) - just the
         search box (with the mockup's own icon) and the two buttons, matching
         the mockup's .head row minus its title.
       - Only the 4 real fields (Name/IdentityNumber/Phone/Address) - the
         mockup's "العقود النشطة"/"رأس المال في العقود"/"الربح المحقق" columns
         were tried once and explicitly rejected: no new columns, computed or
         not - back to the plain table.
       - DataGrid header/row colors are styled here (BrushSoft header
         background, BrushLine2 row separators, matching the mockup's .t table
         CSS) since Avalonia's default DataGrid theme doesn't resemble it at
         all otherwise - scoped to this screen only, not Theme.axaml globally,
         until the developer approves it for wider use.
       - The count ("X ملاك") moved into the footer row below the table,
         mirroring the mockup's own .pager position, instead of sitting next to
         a now-removed title. -->
  <UserControl.Styles>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource BrushSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="10" Background="{DynamicResource BrushBg}">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
      <TextBox Grid.Column="0" x:Name="OwnersGridSearchBox" Width="260" TextAlignment="Right"
                Watermark="الاسم، الجوال، رقم الهوية">
        <TextBox.InnerLeftContent>
          <Viewbox Width="16" Height="16" Margin="9,0,0,0" FlowDirection="LeftToRight">
            <Canvas Width="24" Height="24">
              <Path Data="{DynamicResource Icon.Search}" Stroke="{DynamicResource BrushMuted}"
                    StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
            </Canvas>
          </Viewbox>
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="2" Classes="outline" Content="تحديث" Click="Refresh_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="3" Classes="add" Content="مالك جديد" Click="AddOwner_Click"/>
    </Grid>

    <!-- Table -->
    <Border Grid.Row="1" Classes="card" Padding="0">
      <DataGrid x:Name="OwnersGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                x:DataType="models:OwnerInstallment"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{DynamicResource BrushLine2}"
                HeadersVisibility="Column"
                RowBackground="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <DataGrid.Columns>
          <DataGridTextColumn Header="رقم المالك" Binding="{Binding Id, StringFormat='O-{0}'}" Width="90"/>
          <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.4*"/>
          <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="150"/>
          <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="160"/>
          <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"/>
          <DataGridTemplateColumn Header="" Width="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="models:OwnerInstallment">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4">
                  <Button Classes="outline" Content="العقود" Padding="10,4" FontSize="12"
                          Click="OpenContracts_Click"/>
                  <Button Classes="outline" Content="تعديل" Padding="10,4" FontSize="12"
                          Click="EditOwner_Click"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Footer - same proven column order as the list-heading pattern used
         elsewhere (title/count in the star column, hint in the Auto column,
         no HorizontalAlignment on either - see docs/ui-lessons.md #1). -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" x:Name="OwnersCountText" FontSize="13" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="اضغط مرتين على الصف لتعديل بيانات المالك"
                 FontSize="12" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
    </Grid>

  </Grid>
</UserControl>
