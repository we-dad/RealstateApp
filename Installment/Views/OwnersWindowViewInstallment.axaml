<Window x:Class="RealEstateInstallmentsManager.Views.OwnersWindowViewInstallment"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        Title="معلومات المالك"
        Width="700"
        Height="560"
        FlowDirection="RightToLeft">

    <!-- Restyled on the new identity per the client's reference mockup
         (owner-new.html) - same 4 fields and logic as before, no new data (see
         OwnersViewInstallment.axaml's own comment for why: the mockup's owner is
         a full investor with capital/profit-share/IBAN fields we don't store). -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12" Background="{DynamicResource BrushBg}">

        <!-- Row 0: editable owner form -->
        <Border Grid.Row="0" Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="المالك" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="6">
                    <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="1" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
                    <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="0" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
                    <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="0"/>
                    <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="1" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
                    <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="1"/>
                    <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="0" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
                    <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="0"/>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Left">
                        <Button Classes="danger" Content="حذف البيانات" Click="Delete_Click"/>
                        <Button Classes="primary" Content="تحديث البيانات" Click="Update_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 1: read-only saved values -->
        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات المالك" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="16" RowSpacing="6">
                    <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource BrushMuted}"/>
                    <SelectableTextBlock x:Name="ResultNameBox" Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource BrushMuted}"/>
                    <SelectableTextBlock x:Name="ResultIdentityNumberBox" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource BrushMuted}"/>
                    <SelectableTextBlock x:Name="ResultPhoneBox" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource BrushInk}"/>
                    <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="0" Foreground="{DynamicResource BrushMuted}"/>
                    <SelectableTextBlock x:Name="ResultAddressBox" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource BrushInk}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: products grid fills remaining space -->
        <Border Grid.Row="2" Classes="card" Padding="8">
            <DockPanel>
                <TextBlock Text="منتجات المالك" DockPanel.Dock="Top" Margin="8,4" FontSize="14"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
                <DataGrid x:Name="ProductsGrid"
                          x:DataType="models:ProductInstallment"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج"   Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="النوع"    Binding="{Binding ProductType}" Width="Auto"/>
                        <DataGridTextColumn Header="السعر"    Binding="{Binding ProductMainPrice, StringFormat='{}{0:N2}'}" Width="Auto"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
