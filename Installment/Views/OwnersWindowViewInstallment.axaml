<Window x:Class="RealEstateInstallmentsManager.Views.OwnersWindowViewInstallment"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
        Title="معلومات المالك"
        Width="700"
        Height="560"
        FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12">

        <!-- Row 0: editable owner form -->
        <Border Grid.Row="0" Padding="12" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="المالك" FontSize="18"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0"/>
                    <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0"/>
                    <TextBlock Text="رقم الهوية" Grid.Row="0" Grid.Column="1"/>
                    <TextBox x:Name="IdentityNumberBox" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="0"/>
                    <TextBox x:Name="PhoneBox" Grid.Row="3" Grid.Column="0"/>
                    <TextBlock Text="العنوان" Grid.Row="2" Grid.Column="1"/>
                    <TextBox x:Name="AddressBox" Grid.Row="3" Grid.Column="1"/>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Left">
                        <Button Content="تحديث البيانات" Click="Update_Click"/>
                        <Button Content="حذف البيانات" Click="Delete_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 1: read-only saved values -->
        <Border Grid.Row="1" Padding="12" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات المالك" Foreground="Gray"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="16" RowSpacing="6">
                    <TextBlock Text="الاسم" Grid.Row="0" Grid.Column="0" Foreground="Gray"/>
                    <TextBlock x:Name="ResultNameBox" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Text="رقم الهوية" Grid.Row="1" Grid.Column="0" Foreground="Gray"/>
                    <TextBlock x:Name="ResultIdentityNumberBox" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="الجوال" Grid.Row="2" Grid.Column="0" Foreground="Gray"/>
                    <TextBlock x:Name="ResultPhoneBox" Grid.Row="2" Grid.Column="1"/>
                    <TextBlock Text="العنوان" Grid.Row="3" Grid.Column="0" Foreground="Gray"/>
                    <TextBlock x:Name="ResultAddressBox" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: products grid fills remaining space -->
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1" Padding="4">
            <DockPanel>
                <TextBlock Text="منتجات المالك" DockPanel.Dock="Top" Margin="8,4" FontSize="14"/>
                <DataGrid x:Name="ProductsGrid"
                          x:DataType="models:ProductInstallment"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج"   Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="النوع"    Binding="{Binding ProductType}" Width="Auto"/>
                        <DataGridTextColumn Header="السعر"    Binding="{Binding ProductMainPrice, StringFormat='{}{0:N2}'}" Width="Auto"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>