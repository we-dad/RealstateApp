<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RealEstateInstallmentsManager.Models"
             x:Class="RealEstateInstallmentsManager.Views.ContractWindowViewInstallment"
             x:DataType="models:ContractInstallment"
             Title="معلومات العميل"
             Width="700"
             Height="750">


   <Grid RowDefinitions="Auto,*" Margin="6">

        <Border Padding="12" CornerRadius="12"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="عقد البيع" FontSize="18" TextAlignment="Right"/>

                <!-- Entry mode: auto / manual (left side) -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                    <RadioButton x:Name="AutoModeRadio" Content="تلقائي" IsChecked="True"
                                 IsCheckedChanged="Mode_Changed"/>
                    <RadioButton x:Name="ManualModeRadio" Content="يدوي"
                                 IsCheckedChanged="Mode_Changed"/>
                    <TextBlock Text=": طريقة الإدخال" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBox x:Name="ContractNumBox" Grid.Row="1" Grid.Column="1"
                             TextAlignment="Right" IsReadOnly="True"/>

                    <TextBlock Text="تاريخ العقد" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>
                    <DatePicker x:Name="ContractDateStartPicker" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>

                    <TextBlock Text="اسم المنتج" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <ComboBox x:Name="ProductsBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="ProductsBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductInstallment">
                                <TextBlock Text="{Binding ProductName}" TextAlignment="Right"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="هوية العميل"
                               Grid.Row="2"
                               Grid.Column="0"
                               TextAlignment="Right"/>

                    <Grid Grid.Row="3"
                          Grid.Column="0"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowSpacing="4">

                        <Button Content="بحث"
                                Grid.Row="0"
                                Grid.Column="0"
                                Click="SearchCustomer_Click"/>

                        <TextBox x:Name="CustomerIdSearchBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Right"
                                 Watermark="اكتب رقم الهوية"/>

                        <TextBlock x:Name="CustomerInfoText"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   TextAlignment="Right"
                                   Foreground="Green"/>
                    </Grid>

                    <TextBlock Text="نسبة الفائدة السنوية"
                               Grid.Row="4"
                               Grid.Column="0"
                               TextAlignment="Right"
                               FlowDirection="RightToLeft"/>

                    <StackPanel Grid.Row="5" Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    FlowDirection="RightToLeft">

                            <ComboBox x:Name="InterestPercentBox"
                                      HorizontalAlignment="Stretch"
                                      FlowDirection="RightToLeft"
                                      SelectionChanged="InterestPercentBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="%"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="CustomInterestBox"
                                     Width="100"
                                     Watermark="النسبة"
                                     TextAlignment="Right"
                                     IsVisible="False"
                                     TextChanged="CustomInterestBox_TextChanged"/>
                        </StackPanel>

                        <TextBlock x:Name="CustomInterestErrorText"
                                   Foreground="Red"
                                   FontSize="12"
                                   TextAlignment="Right"/>
                    </StackPanel>

                    <TextBlock Text="رسوم ادارية"
                               Grid.Row="4"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    FlowDirection="RightToLeft">
                            <TextBox x:Name="ManagementFeeBox"
                                     Width="150"
                                     TextAlignment="Right"
                                     TextChanged="ManagementFeeBox_TextChanged"/>
                            <TextBlock Text="ريال"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="ManagementFeeErrorText"
                                   Foreground="Red"
                                   FontSize="12"
                                   TextAlignment="Right"/>
                    </StackPanel>

                    <TextBlock Text="مدة العقد"
                               Grid.Row="6"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    FlowDirection="RightToLeft">
                            <TextBox x:Name="ContractPeriodBox"
                                     Width="150"
                                     TextAlignment="Right"
                                     TextChanged="ContractPeriodBox_TextChanged"/>
                            <TextBlock Text="شهر"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ContractPeriodErrorText"
                                   Foreground="Red"
                                   FontSize="12"
                                   TextAlignment="Right"/>
                    </StackPanel>

                    <TextBlock Text="اجمالي قيمة المنتج"
                               Grid.Row="6"
                               Grid.Column="0"
                               TextAlignment="Right"/>

                    <StackPanel Grid.Row="7" Grid.Column="0" Spacing="4">
                        <TextBox x:Name="MainTotalAmountBox"
                                 TextAlignment="Right"
                                 Text="{Binding MainTotalAmount}"
                                 IsReadOnly="True"
                                 TextChanged="MainTotalAmountBox_TextChanged"/>
                    </StackPanel>

                    <TextBlock Text="القسط الشهري"
                               Grid.Row="8"
                               Grid.Column="1"
                               TextAlignment="Right"/>

                    <StackPanel Grid.Row="9" Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="MonthlyInstallmentBox"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   TextAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Stretch"
                                FlowDirection="RightToLeft"
                                Grid.Row="9"
                                Grid.Column="0">

                        <CheckBox Content="بدفعة مقدمة"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding BoolDownPayment, Mode=TwoWay}" />

                        <StackPanel Spacing="4">
                            <TextBox x:Name="DownPaymentBox"
                                     Width="150"
                                     Watermark="ادخل الرقم"
                                     TextAlignment="Right"
                                     IsVisible="{Binding BoolDownPayment}"
                                     TextChanged="DownPaymentBox_TextChanged"/>

                            <TextBlock x:Name="DownPaymentErrorText"
                                       Foreground="Red"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       IsVisible="{Binding BoolDownPayment}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="حذف البيانات" Click="Delete_Click"/>
                    <Button Content="تحديث البيانات" Click="Update_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
             
       <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Margin="0,10,0,0">

    <StackPanel Spacing="10">

        <!-- Contract Info (readout, unchanged content) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="بيانات العقد" HorizontalAlignment="Right"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="8">

                    <TextBlock Text="رقم العقد" Grid.Row="0" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractNumBox" Grid.Row="0" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ بدء العقد" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractDateStartBox" Grid.Row="1" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="تاريخ انتهاء العقد" Grid.Row="2" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractDateEndBox" Grid.Row="2" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="اجمالي مبلغ السلعة" Grid.Row="3" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultProductTotalAmount" Grid.Row="3" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="نسبة الفائدة السنوية" Grid.Row="4" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultInterestPercentBox" Grid.Row="4" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="مدة العقد" Grid.Row="5" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultContractPeriodBox" Grid.Row="5" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="دفعة مقدمة" Grid.Row="6" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultDownPaymentBox" Grid.Row="6" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="نسبة الرسوم الادارية" Grid.Row="7" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultManagementFeeBox" Grid.Row="7" Grid.Column="0" TextAlignment="Right"/>

                    <TextBlock Text="مبلغ القسط الشهري" Grid.Row="8" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock x:Name="ResultMonthlyInstallmentBox" Grid.Row="8" Grid.Column="0" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Product (single-row grid, double-tap opens product) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح السلعة"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات المنتج" TextAlignment="Right"/>
                </Grid>

                <DataGrid x:Name="ProductGrid"
                          x:DataType="models:ProductInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="1.5*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ProductType}" Width="*"/>
                        <DataGridTextColumn Header="السعر الأساسي" Binding="{Binding ProductMainPrice, StringFormat='{}{0:N2}'}" Width="*"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Customer (single-row grid, double-tap opens customer) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح العميل"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات العميل" TextAlignment="Right"/>
                </Grid>

                <DataGrid x:Name="CustomerGrid"
                          x:DataType="models:CustomerInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="*"/>
                        <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="الكفيل" Binding="{Binding SponserName}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Owner (single-row grid, double-tap opens owner) -->
        <Border CornerRadius="12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="انقر مرتين لفتح المالك"
                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="بيانات المالك" TextAlignment="Right"/>
                </Grid>

                <DataGrid x:Name="OwnerGrid"
                          x:DataType="models:OwnerInstallment"
                          FlowDirection="RightToLeft"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="رقم الهوية" Binding="{Binding IdentityNumber}" Width="*"/>
                        <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

    </StackPanel>
</ScrollViewer>
        
    </Grid>

</Window>
